@model Web.Controllers.GroupPageViewModel
@using AppCore.Entities
@{
    var group = Model.Group;
    ViewData["Title"] = group.Name;

    static string EventDate(Post p) => (p.EventDate ?? p.PublishedToWebAt ?? p.CreatedAt).ToString("MMMM dd, yyyy");
    static string NoticeDate(Announcement a) => (a.PublishedToWebAt ?? a.CreatedAt).ToString("MMM dd, yyyy");
    static string LeaderName(SocialGroupMember m)
    {
        if (!string.IsNullOrWhiteSpace(m.User?.DisplayName))
        {
            return m.User.DisplayName;
        }
        var fullName = $"{m.User?.FirstName} {m.User?.LastName}".Trim();
        return fullName.Length > 0 ? fullName : "Member";
    }
}

<!-- Group Banner -->
<section class="group-banner" style="background-image: url('@(group.CoverImageUrl ?? "/images/category/category1.jpg")');">
    <div class="group-banner-overlay">
        <div class="container">
            <div class="d-flex align-items-end gap-4 flex-wrap">
                <img class="group-banner-avatar" src="@(group.AvatarUrl ?? group.CoverImageUrl ?? "/images/category/category1.jpg")" alt="@group.Name">
                <div class="group-banner-text">
                    <h1>@group.Name</h1>
                    <p class="mb-0">
                        <i class="feather icon-users me-1"></i> @Model.MemberCount member@(Model.MemberCount == 1 ? "" : "s")
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-space3">
    <div class="container">
        <div class="row">
            <div class="col-xl-8 col-lg-7">
                <div class="content-wrapper left-side">

                    <!-- About the group -->
                    <div class="group-section mb-40">
                        <h5 class="widget-title mb-20">About @group.Name</h5>
                        @if (!string.IsNullOrEmpty(group.Description))
                        {
                            <p>@group.Description</p>
                        }
                        else
                        {
                            <p>Welcome to the @group.Name group of Tema Friends Club of Maryland.</p>
                        }
                        @if (!string.IsNullOrEmpty(group.Rules))
                        {
                            <h6 class="mt-3">Group Guidelines</h6>
                            <p>@group.Rules</p>
                        }
                    </div>

                    <!-- Upcoming events -->
                    <div class="group-section mb-40">
                        <h5 class="widget-title mb-20">Upcoming Events</h5>
                        @if (Model.UpcomingEvents.Any())
                        {
                            <div class="row">
                                @foreach (var ev in Model.UpcomingEvents)
                                {
                                    <div class="col-md-6">
                                        <div class="post-card mb-30">
                                            <div class="post-thumb">
                                                <a asp-controller="Post" asp-action="Details" asp-route-id="@ev.Id">
                                                    <img src="@(ev.FeaturedImageUrl ?? "/images/posts/img1.jpg")" alt="@ev.Title">
                                                </a>
                                            </div>
                                            <div class="post-content">
                                                <ul class="post-meta">
                                                    <li class="date"><i class="feather icon-calendar me-1"></i>@EventDate(ev)</li>
                                                </ul>
                                                <h5 class="post-title">
                                                    <a asp-controller="Post" asp-action="Details" asp-route-id="@ev.Id">@ev.Title</a>
                                                </h5>
                                                @if (!string.IsNullOrEmpty(ev.Excerpt))
                                                {
                                                    <p>@ev.Excerpt</p>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No upcoming events scheduled — check back soon.</p>
                        }
                    </div>

                    <!-- Past events -->
                    <div class="group-section mb-40">
                        <h5 class="widget-title mb-20">Past Events</h5>
                        @if (Model.PastEvents.Any())
                        {
                            <div class="row">
                                @foreach (var ev in Model.PastEvents)
                                {
                                    <div class="col-md-6">
                                        <div class="post-card mb-30 past-event">
                                            <div class="post-thumb">
                                                <a asp-controller="Post" asp-action="Details" asp-route-id="@ev.Id">
                                                    <img src="@(ev.FeaturedImageUrl ?? "/images/posts/img2.jpg")" alt="@ev.Title">
                                                </a>
                                            </div>
                                            <div class="post-content">
                                                <ul class="post-meta">
                                                    <li class="date"><i class="feather icon-calendar me-1"></i>@EventDate(ev)</li>
                                                </ul>
                                                <h6 class="post-title">
                                                    <a asp-controller="Post" asp-action="Details" asp-route-id="@ev.Id">@ev.Title</a>
                                                </h6>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No past events recorded yet.</p>
                        }
                    </div>

                </div>
            </div>

            <div class="col-xl-4 col-lg-5">
                <aside class="aside-wrapper">

                    <!-- Member count -->
                    <div class="widget group-stat-widget text-center">
                        <div class="group-stat-number">@Model.MemberCount</div>
                        <div class="group-stat-label">Group Member@(Model.MemberCount == 1 ? "" : "s")</div>
                    </div>

                    <!-- Leaders -->
                    <div class="widget">
                        <h5 class="widget-title">Group Leaders</h5>
                        @if (Model.Leaders.Any())
                        {
                            <ul class="group-leader-list">
                                @foreach (var leader in Model.Leaders)
                                {
                                    <li>
                                        <img src="@(leader.User?.AvatarUrl ?? "/images/media/media.jpg")" alt="@LeaderName(leader)">
                                        <div>
                                            <span class="leader-name">@LeaderName(leader)</span>
                                            <span class="leader-role">@leader.Role</span>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted">Leaders will be announced soon.</p>
                        }
                    </div>

                    <!-- Group notice board -->
                    <div class="widget group-notice-widget">
                        <h5 class="widget-title"><i class="feather icon-bell me-1"></i> Group Notice Board</h5>
                        @if (Model.Notices.Any())
                        {
                            <ul class="group-notice-list">
                                @foreach (var notice in Model.Notices)
                                {
                                    <li>
                                        <span class="notice-title">
                                            @if (notice.IsPriority)
                                            {
                                                <i class="feather icon-star text-warning me-1"></i>
                                            }
                                            @notice.Title
                                        </span>
                                        @if (!string.IsNullOrEmpty(notice.TickerText))
                                        {
                                            <span class="notice-text">@notice.TickerText</span>
                                        }
                                        <span class="notice-date">@NoticeDate(notice)</span>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted">No notices posted for this group yet.</p>
                        }
                    </div>

                    <!-- Other groups -->
                    @if (Model.OtherGroups.Any())
                    {
                        <div class="widget">
                            <h5 class="widget-title">Other Groups</h5>
                            <ul class="other-group-list">
                                <li>
                                    <a asp-controller="Charity" asp-action="Index">Charity</a>
                                </li>
                                @foreach (var other in Model.OtherGroups)
                                {
                                    <li>
                                        <a asp-controller="Groups" asp-action="Details" asp-route-id="@(other.Slug ?? other.Id.ToString())">@other.Name</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                </aside>
            </div>
        </div>
    </div>
</section>

<style>
    .group-banner {
        background-size: cover;
        background-position: center;
        position: relative;
    }

    .group-banner-overlay {
        background: linear-gradient(180deg, rgba(0, 0, 0, 0.25), rgba(0, 0, 0, 0.65));
        padding: 120px 0 30px;
    }

    .group-banner-avatar {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        border: 4px solid #fff;
        object-fit: cover;
        background: #fff;
    }

    .group-banner-text h1,
    .group-banner-text p {
        color: #fff;
    }

    .group-section p {
        color: #555;
    }

    .past-event .post-thumb img {
        filter: grayscale(35%);
    }

    .group-stat-widget {
        background: var(--theme-color-primary, #0d6efd);
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 30px;
    }

    .group-stat-number {
        font-size: 42px;
        font-weight: 700;
        color: #fff;
        line-height: 1;
    }

    .group-stat-label {
        color: rgba(255, 255, 255, 0.85);
        margin-top: 6px;
        letter-spacing: 1px;
        text-transform: uppercase;
        font-size: 12px;
    }

    .group-leader-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .group-leader-list li {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .group-leader-list li:last-child {
        border-bottom: 0;
    }

    .group-leader-list img {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        object-fit: cover;
    }

    .leader-name {
        display: block;
        font-weight: 600;
        color: #333;
    }

    .leader-role {
        display: block;
        font-size: 12px;
        color: #999;
    }

    .group-notice-widget {
        background: #fff8e6;
        border: 1px solid #ffe1a1;
        border-radius: 12px;
        padding: 20px;
    }

    .group-notice-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .group-notice-list li {
        padding: 10px 0;
        border-bottom: 1px dashed #ffd97a;
    }

    .group-notice-list li:last-child {
        border-bottom: 0;
    }

    .notice-title {
        display: block;
        font-weight: 600;
        color: #333;
    }

    .notice-text {
        display: block;
        font-size: 13px;
        color: #777;
        margin-top: 2px;
    }

    .notice-date {
        display: block;
        font-size: 12px;
        color: #9a8250;
        margin-top: 2px;
    }

    .other-group-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .other-group-list li {
        border-bottom: 1px solid #f0f0f0;
    }

    .other-group-list li:last-child {
        border-bottom: 0;
    }

    .other-group-list li a {
        display: block;
        padding: 9px 4px;
        color: #333;
        text-decoration: none;
    }

    .other-group-list li a:hover {
        color: var(--theme-color-primary, #0d6efd);
    }
</style>
