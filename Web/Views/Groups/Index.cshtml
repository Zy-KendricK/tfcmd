@model IList<AppCore.Entities.SocialGroup>
@{
    ViewData["Title"] = "Our Groups";
    var fallbackImages = new[] { "/images/category/category2.jpg", "/images/category/category3.jpg", "/images/category/category4.jpg", "/images/category/category5.jpg" };
}

<section class="section-space3">
    <div class="container">
        <div class="page-title text-center mb-5">
            <h1>Our Groups</h1>
            <p class="lead">Explore the different groups within Tema Friends Club of Maryland</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="card-catogary group-card">
                    <img class="media" src="~/images/category/category1.jpg" alt="Charity">
                    <div class="group-info">
                        <h4>Charity</h4>
                        <p>Making a difference through charitable initiatives and community support programs.</p>
                        <a asp-controller="Charity" asp-action="Index" class="btn btn-primary-light btn-line">Learn
                            More</a>
                    </div>
                </div>
            </div>
            @if (Model.Any())
            {
                for (var i = 0; i < Model.Count; i++)
                {
                    var group = Model[i];
                    <div class="col-lg-4 col-md-6">
                        <div class="card-catogary group-card">
                            <img class="media" src="@(group.CoverImageUrl ?? group.AvatarUrl ?? fallbackImages[i % fallbackImages.Length])" alt="@group.Name">
                            <div class="group-info">
                                <h4>@group.Name</h4>
                                <p>@(group.Description?.Length > 110 ? group.Description.Substring(0, 110) + "…" : group.Description ?? "Join us and be part of the community.")</p>
                                <a asp-controller="Groups" asp-action="Details" asp-route-id="@(group.Slug ?? group.Id.ToString())"
                                    class="btn btn-primary-light btn-line">Learn More</a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card-catogary group-card">
                        <img class="media" src="~/images/category/category2.jpg" alt="Community">
                        <div class="group-info">
                            <h4>Community</h4>
                            <p>Building connections and fostering relationships within our community.</p>
                            <span class="btn btn-primary-light btn-line disabled" aria-disabled="true">Coming Soon</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="card-catogary group-card">
                        <img class="media" src="~/images/category/category3.jpg" alt="Culture">
                        <div class="group-info">
                            <h4>Culture</h4>
                            <p>Preserving and celebrating Ghanaian heritage and traditions.</p>
                            <span class="btn btn-primary-light btn-line disabled" aria-disabled="true">Coming Soon</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<style>
    .group-card {
        position: relative;
        overflow: hidden;
        border-radius: 15px;
        margin-bottom: 20px;
    }

    .group-card .media {
        width: 100%;
        height: 200px;
        object-fit: cover;
    }

    .group-card .group-info {
        padding: 20px;
        background: white;
    }

    .group-card h4 {
        margin-bottom: 10px;
    }

    .group-card p {
        margin-bottom: 15px;
        color: #666;
    }
</style>
