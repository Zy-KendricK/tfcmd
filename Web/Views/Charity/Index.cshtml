                    var counter = counters[i];
                    <div class="col-md-3 col-sm-6">
                        <div class="single-counter">
                            <img src="@(string.IsNullOrWhiteSpace(counter.ImageUrl) ? counterIcons[i % counterIcons.Length] : counter.ImageUrl)" alt="">
