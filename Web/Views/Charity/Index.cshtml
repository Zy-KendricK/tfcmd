@using AppCore.Entities
@using Web.Controllers
@model CharityPageViewModel
@{
    ViewData["Title"] = "TFC Charity";

    static int ProgressPercent(AppCore.Entities.CharityProject p)
    {
        if (p.GoalAmount is null || p.GoalAmount == 0 || p.CurrentAmount is null)
        {
            return 0;
        }
        return (int)Math.Clamp(Math.Round(p.CurrentAmount.Value / p.GoalAmount.Value * 100), 0, 100);
    }

    var banner = Model.FirstFor(CharityPageSection.Banner);
    var bannerImages = Model.ItemsFor(CharityPageSection.Banner)
        .Where(i => !string.IsNullOrWhiteSpace(i.ImageUrl))
        .Select(i => i.ImageUrl!)
        .ToList();
    var defaultGallery = new[]
    {
        "/charity/images/banner/banner-s1.jpg",
        "/charity/images/banner/banner-s3.jpg",
        "/charity/images/banner/banner-s4.jpg",
        "/charity/images/banner/banner-s2.jpg"
    };
    var gallery = bannerImages.Concat(defaultGallery.Skip(bannerImages.Count)).Take(4).ToList();
    var bannerBadges = (string.IsNullOrWhiteSpace(banner?.Meta)
            ? "Eliminate Proverty,Better Health,Mass Education"
            : banner!.Meta!)
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    var features = Model.ItemsFor(CharityPageSection.Feature);
    var history = Model.FirstFor(CharityPageSection.History);
    var historyImages = Model.ItemsFor(CharityPageSection.History)
        .Where(i => !string.IsNullOrWhiteSpace(i.ImageUrl))
        .Select(i => i.ImageUrl!)
        .ToList();
    var defaultHistoryImages = new[]
    {
        "/charity/images/other/rs-1.jpg",
        "/charity/images/other/rs-2.jpg",
        "/charity/images/other/rs-3.jpg"
    };
    var historyGallery = historyImages.Concat(defaultHistoryImages.Skip(historyImages.Count)).Take(3).ToList();
    var mission = Model.FirstFor(CharityPageSection.Mission);
    var counters = Model.ItemsFor(CharityPageSection.Counter);
    var events = Model.ItemsFor(CharityPageSection.Event);
    var partners = Model.ItemsFor(CharityPageSection.Partner);
}

@section Styles {
    <link rel="stylesheet" href="~/charity/css/font/flaticon.css">
    <link rel="stylesheet" href="~/charity/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/charity/css/animate.css">
    <link rel="stylesheet" href="~/charity/css/magnific-popup.css">
    <link rel="stylesheet" href="~/charity/css/nice-select.css">
    <link rel="stylesheet" href="~/charity/css/style.css">
}

<!-- Banner Area Start -->
<section class="banner-area banner-1 pt-2">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 col-md-6 order-md-1 order-2">
                <div class="banner-info pe-lg-5 mt-3 mt-sm-0">
                    @if (banner != null && !string.IsNullOrWhiteSpace(banner.Title))
                    {
                        <h1 class="banner-title">
                            @banner.Title
                            @if (!string.IsNullOrWhiteSpace(banner.Highlight))
                            {
                                <span style="color: #34afe6;">@banner.Highlight</span>
                            }
                        </h1>
                        <p>@banner.Text</p>
                    }
                    else
                    {
                        <h1 class="banner-title">Transforming <span style="color: #34afe6;">Lives</span> One Step at a Time
                        </h1>
                        <p>Together, we can provide hope, support, and a brighter future for those in need. Your
                            contribution can change lives.</p>
                    }

                    <div class="banner-btn mt-5 d-flex align-items-center">
                        <a asp-controller="Contact" asp-action="Index" class="custom-btn">Get Started</a>
                        <div class="video-block ms-5">
                            <div class="waves wave-1"></div>
                            <div class="waves wave-2"></div>
                            <div class="waves wave-3"></div>
                            <a href="https://www.youtube.com/watch?v=wJuuWnDrOEg" class="video vedio-popup"
                                data-autoplay="true" data-vbtype="video"><i class="fa fa-play"></i></a>
                        </div>
                    </div>
                    <div class="banner-meta mt-5">
                        @foreach (var badge in bannerBadges)
                        {
                            <span>@badge</span>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 order-md-2 order-1">
                <div class="banner-gallery position-relative row g-2 g-lg-3">
                    <div class="col">
                        <div class="bg-item">
                            <img class="img-fluid rounded-4" src="@gallery[0]" alt="Banner">
                        </div>
                        <div class="bg-item">
                            <img class="img-fluid rounded-4" src="@gallery[1]" alt="">
                        </div>
                    </div>
                    <div class="col">
                        <div class="bg-item">
                            <img class="img-fluid rounded-4" src="@gallery[2]" alt="">
                        </div>
                        <div class="bg-item">
                            <img class="img-fluid rounded-4" src="@gallery[3]" alt="">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Banner Area End -->

