                    <p>We are grateful for the support of our amazing partners who help us make a difference.</p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12">
                <div class="partner-wrap owl-carousel">
                    @if (partners.Any())
                    {
                        foreach (var partner in partners)
                        {
                            <div class="partner-name">
                                <img src="@partner.ImageUrl" alt="@(partner.Title ?? "Partner")" title="@partner.Title">
                            </div>
                        }
                    }
                    else
                    {
                        <div class="partner-name">
                            <img src="~/charity/images/partner/pt1.png" alt="Partner">
                        </div>
                        <div class="partner-name">
                            <img src="~/charity/images/partner/pt2.png" alt="Partner">
                        </div>
                        <div class="partner-name">
                            <img src="~/charity/images/partner/pt3.png" alt="Partner">
                        </div>
                        <div class="partner-name">
                            <img src="~/charity/images/partner/pt4.png" alt="Partner">
                        </div>
                        <div class="partner-name">
                            <img src="~/charity/images/partner/pt5.png" alt="Partner">
                        </div>
                        <div class="partner-name">
                            <img src="~/charity/images/partner/pt6.png" alt="Partner">
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Partner Area End -->

