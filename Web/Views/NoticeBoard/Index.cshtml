@model Web.Controllers.NoticeBoardViewModel
@using AppCore.Entities
@{
    ViewData["Title"] = "Notice Board";

    static string NoticeDate(Announcement a) => (a.PublishedToWebAt ?? a.CreatedAt).ToString("MMMM dd, yyyy");
}

<section class="section-space3">
    <div class="container">
        <div class="page-title text-center mb-5">
            <h1>Notice Board</h1>
            <p class="lead">Announcements from Tema Friends Club of Maryland</p>
        </div>

        <div class="row">
            <div class="col-xl-8 col-lg-7">
                <div class="content-wrapper left-side">
                    <h5 class="widget-title mb-30">All Announcements</h5>
                    @if (Model.Announcements.Any())
                    {
                        @foreach (var item in Model.Announcements)
                        {
                            <div class="post-card notice-card mb-30">
                                <div class="d-flex gap-3 align-items-start">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <div class="notice-thumb">
                                            <a asp-action="Details" asp-route-id="@item.Id">
                                                <img src="@item.ImageUrl" alt="@item.Title">
                                            </a>
                                        </div>
                                    }
                                    <div class="post-content flex-grow-1">
                                        <ul class="post-meta">
                                            <li class="date"><a asp-action="Details" asp-route-id="@item.Id">@NoticeDate(item)</a></li>
                                        </ul>
                                        <h4 class="post-title">
                                            <a asp-action="Details" asp-route-id="@item.Id">@item.Title</a>
                                        </h4>
                                        @if (!string.IsNullOrEmpty(item.TickerText))
                                        {
                                            <p>@item.TickerText</p>
                                        }
                                        <a class="btn-link" asp-action="Details" asp-route-id="@item.Id">READ MORE
                                            <i class="feather icon-arrow-right ms-1"></i></a>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (Model.TotalPages > 1)
                        {
                            <div class="text-center mb-30">
                                @if (Model.CurrentPage > 1)
                                {
                                    <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)"
                                        class="btn btn-light btn-line me-2">PREVIOUS</a>
                                }
                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)"
                                        class="btn btn-light btn-line">LOAD MORE</a>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <p class="mb-50">No announcements have been posted yet. Please check back soon.</p>
                    }
                </div>
            </div>
            <div class="col-xl-4 col-lg-5">
                <aside class="aside-wrapper">
                    <div class="widget widget-priority-notices">
                        <h5 class="widget-title"><i class="feather icon-star me-1"></i> Priority Announcements</h5>
                        @if (Model.PriorityAnnouncements.Any())
                        {
                            <ul class="priority-notice-list">
                                @foreach (var item in Model.PriorityAnnouncements)
                                {
                                    <li>
                                        <a asp-action="Details" asp-route-id="@item.Id">
                                            <span class="priority-notice-title">@item.Title</span>
                                            <span class="priority-notice-date">@NoticeDate(item)</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted">No priority announcements right now.</p>
                        }
                    </div>
                </aside>
            </div>
        </div>
    </div>
</section>

<style>
    .notice-card {
        border: 1px solid #eee;
        border-radius: 12px;
        padding: 20px;
        background: #fff;
    }

    .notice-thumb {
        flex: 0 0 140px;
    }

    .notice-thumb img {
        width: 140px;
        height: 100px;
        object-fit: cover;
        border-radius: 8px;
    }

    .widget-priority-notices {
        background: #fff8e6;
        border: 1px solid #ffe1a1;
        border-radius: 12px;
        padding: 20px;
        position: sticky;
        top: 100px;
    }

    .priority-notice-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .priority-notice-list li {
        border-bottom: 1px dashed #ffd97a;
    }

    .priority-notice-list li:last-child {
        border-bottom: 0;
    }

    .priority-notice-list li a {
        display: block;
        padding: 10px 4px;
        text-decoration: none;
    }

    .priority-notice-list li a:hover .priority-notice-title {
        color: var(--theme-color-primary, #0d6efd);
    }

    .priority-notice-title {
        display: block;
        font-weight: 600;
        color: #333;
        line-height: 1.3;
    }

    .priority-notice-date {
        display: block;
        font-size: 12px;
        color: #9a8250;
        margin-top: 2px;
    }
</style>
