						</div>
						<div class="post-content">
							<h3 class="post-title">
								<a asp-controller="Post" asp-action="Details" asp-route-id="@Model.HeroFeatured.Id">
									@Model.HeroFeatured.Title
								</a>
							</h3>
							<ul class="post-meta">
								<li class="author">
									<img src="@(Model.HeroFeatured.Author?.AvatarUrl ?? "/images/posts/middle-post/middle-post1.jpg")" alt="">
									By <a asp-controller="Post" asp-action="Details" asp-route-id="@Model.HeroFeatured.Id">@AuthorName(Model.HeroFeatured)</a>
								</li>
								<li class="date"><a asp-controller="Post" asp-action="Details" asp-route-id="@Model.HeroFeatured.Id">@PostDate(Model.HeroFeatured)</a></li>
								<li class="tag"><a asp-controller="Post" asp-action="Category" asp-route-id="@(Model.HeroFeatured.Category?.Slug ?? Model.HeroFeatured.CategoryId?.ToString() ?? "")">@PostTag(Model.HeroFeatured)</a></li>
