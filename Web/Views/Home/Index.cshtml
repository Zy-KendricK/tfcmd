					</div>
				</div>
				<div class="col-lg-6 order-1">
					<div class="post-grid-center">
						<div class="post-card post-card-large">
							<div class="post-thumb">
								<a asp-controller="Post" asp-action="Events"><img
										src="~/images/posts/large-post/large-post2.jpg" alt=""></a>
							</div>
							<div class="post-content">
