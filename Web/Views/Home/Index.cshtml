									src="~/images/posts/popular-post/post2.jpg" alt=""></a>
						</div>
						<div class="post-content">
							<h5 class="post-title"><a asp-controller="Post" asp-action="Events">Lifestyle
									changes to
									transform your life</a></h5>
						</div>
					</div>
				</div>
				<div class="col-lg-3 col-6 post-grid-column order-2 order-lg-1">
					<div class="post-card post-card-small">
						<div class="post-thumb">
							<a asp-controller="Post" asp-action="Events"><img
