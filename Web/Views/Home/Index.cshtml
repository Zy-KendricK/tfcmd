<section class="section-space3 bg-white">
	<div class="container">
		<h5 class="widget-title mb-30">Events
			<a asp-controller="Post" asp-action="Events" class="btn-link float-end">View All Post</a>
		</h5>
		<div class="row post-grid-wrapper mb-30">
			@if (Model.EventsFeatured != null || Model.EventsSecondary.Any())
			{
				var eventFallbackImages = new[] { "/images/posts/popular-post/post1.jpg", "/images/posts/popular-post/post2.jpg", "/images/posts/popular-post/post3.jpg", "/images/posts/popular-post/post4.jpg" };
				var leftEvents = Model.EventsSecondary.Take(2).ToList();
				var rightEvents = Model.EventsSecondary.Skip(2).Take(2).ToList();
				<div class="col-lg-3 col-6 post-grid-column order-2">
					@for (var i = 0; i < leftEvents.Count; i++)
					{
						var post = leftEvents[i];
						<div class="post-card post-card-small">
							<div class="post-thumb">
								<a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id">
									<img src="@(post.FeaturedImageUrl ?? eventFallbackImages[i % eventFallbackImages.Length])" alt="@post.Title">
								</a>
							</div>
							<div class="post-content">
								<h5 class="post-title">
									<a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id">@post.Title</a>
								</h5>
							</div>
						</div>
					}
				</div>
				<div class="col-lg-3 col-6 post-grid-column order-2 order-lg-1">
					@for (var i = 0; i < rightEvents.Count; i++)
					{
						var post = rightEvents[i];
						<div class="post-card post-card-small">
							<div class="post-thumb">
								<a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id">
									<img src="@(post.FeaturedImageUrl ?? eventFallbackImages[(i + 2) % eventFallbackImages.Length])" alt="@post.Title">
								</a>
							</div>
							<div class="post-content">
								<h5 class="post-title"><a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id">@post.Title</a></h5>
							</div>
						</div>
					}
				</div>
				<div class="col-lg-6 order-1">
					<div class="post-grid-center">
						@if (Model.EventsFeatured != null)
						{
							<div class="post-card post-card-large">
