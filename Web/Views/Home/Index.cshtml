@model AppCore.Services.HomePageContent
@using AppCore.Entities
@{
	ViewData["Title"] = "Home";

	static string PostDate(Post p) => (p.PublishedToWebAt ?? p.CreatedAt).ToString("MMMM dd, yyyy");
	static string PostTag(Post p) => p.Category?.Name ?? "General";
	static string AuthorName(Post p)
	{
		if (!string.IsNullOrWhiteSpace(p.Author?.DisplayName))
		{
			return p.Author.DisplayName;
		}
		var fullName = $"{p.Author?.FirstName} {p.Author?.LastName}".Trim();
		return fullName.Length > 0 ? fullName : "TFC Maryland";
	}
}

<section class="section-space3-tp">
