								<div class="post-content">
									<h3 class="post-title"><a asp-controller="Post" asp-action="Details" asp-route-id="@Model.EventsFeatured.Id">@Model.EventsFeatured.Title</a></h3>
									<ul class="post-meta">
										<li class="author">
											<img src="@(Model.EventsFeatured.Author?.AvatarUrl ?? "/images/posts/middle-post/middle-post1.jpg")" alt="">By
											<a asp-controller="Post" asp-action="Details" asp-route-id="@Model.EventsFeatured.Id"> @AuthorName(Model.EventsFeatured)</a>
										</li>
										<li class="date"><a asp-controller="Post" asp-action="Details" asp-route-id="@Model.EventsFeatured.Id">@PostDate(Model.EventsFeatured)</a></li>
										<li class="tag"><a asp-controller="Post" asp-action="Events">@PostTag(Model.EventsFeatured)</a></li>
									</ul>
								</div>
							</div>
						}
					</div>
				</div>
			}
			else
