@if (Model.Announcements.Any())
{
	<div class="announcement-ticker-bar">
		<div class="container">
			<div class="announcement-ticker-inner">
				<span class="announcement-ticker-label"><i class="feather icon-volume-2 me-1"></i> ANNOUNCEMENTS</span>
				<div class="announcement-ticker-viewport">
					<div class="announcement-ticker-track">
						@foreach (var notice in Model.Announcements)
						{
							<a class="announcement-ticker-item" asp-controller="NoticeBoard" asp-action="Details" asp-route-id="@notice.Id">
								@if (notice.IsPriority)
								{
									<i class="feather icon-star"></i>
								}
								@(string.IsNullOrWhiteSpace(notice.TickerText) ? notice.Title : notice.TickerText)
							</a>
						}
						@foreach (var notice in Model.Announcements)
						{
							<a class="announcement-ticker-item" aria-hidden="true" tabindex="-1" asp-controller="NoticeBoard" asp-action="Details" asp-route-id="@notice.Id">
								@if (notice.IsPriority)
								{
									<i class="feather icon-star"></i>
								}
								@(string.IsNullOrWhiteSpace(notice.TickerText) ? notice.Title : notice.TickerText)
							</a>
						}
					</div>
				</div>
				<a class="announcement-ticker-all" asp-controller="NoticeBoard" asp-action="Index">VIEW ALL</a>
			</div>
		</div>
	</div>

	<style>
		.announcement-ticker-bar {
			background: #fff;
			border-top: 1px solid #eee;
			border-bottom: 1px solid #eee;
			padding: 10px 0;
		}

		.announcement-ticker-inner {
			display: flex;
			align-items: center;
			gap: 14px;
		}

		.announcement-ticker-label {
			flex: 0 0 auto;
			font-weight: 700;
			font-size: 12px;
			letter-spacing: 1px;
			color: #fff;
			background: var(--theme-color-primary, #0d6efd);
			padding: 6px 12px;
			border-radius: 20px;
			white-space: nowrap;
		}

		.announcement-ticker-viewport {
			flex: 1 1 auto;
			overflow: hidden;
			position: relative;
		}

		.announcement-ticker-track {
			display: inline-flex;
			gap: 48px;
			white-space: nowrap;
			will-change: transform;
			animation: ticker-scroll 40s linear infinite;
		}

		.announcement-ticker-viewport:hover .announcement-ticker-track {
			animation-play-state: paused;
		}

		.announcement-ticker-item {
			color: #333;
			text-decoration: none;
			font-size: 14px;
		}

		.announcement-ticker-item i {
			color: #f5a623;
			margin-right: 4px;
		}

		.announcement-ticker-item:hover {
			color: var(--theme-color-primary, #0d6efd);
		}

		.announcement-ticker-all {
			flex: 0 0 auto;
			font-size: 12px;
			font-weight: 700;
			letter-spacing: 1px;
			text-decoration: none;
			white-space: nowrap;
		}

		@@keyframes ticker-scroll {
			0% {
				transform: translateX(0);
			}

			100% {
				transform: translateX(-50%);
			}
		}
	</style>
}

<div class="section-space bg-white section-hidden">
	<div class="container">
		<h5 class="widget-title mb-30">Groups</h5>
		<div class="swiper swiper-catogary swiper-mobile">
			<div class="swiper-wrapper">
				@if (Model.HomeGroups.Any())
				{
					var groupFallbackImages = new[] { "/images/category/category1.jpg", "/images/category/category2.jpg", "/images/category/category3.jpg", "/images/category/category4.jpg", "/images/category/category5.jpg" };
					var randomGroups = Model.HomeGroups.OrderBy(_ => Guid.NewGuid()).Take(3).ToList();
					for (var i = 0; i < randomGroups.Count; i++)
					{
						var group = randomGroups[i];
						<div class="swiper-slide">
							<div class="card-catogary">
								<img class="media" src="@(group.CoverImageUrl ?? group.AvatarUrl ?? groupFallbackImages[i % groupFallbackImages.Length])" alt="@group.Name">
								<a asp-controller="Groups" asp-action="Details" asp-route-id="@(group.Slug ?? group.Id.ToString())"
									class="btn btn-light btn-tag">@group.Name.ToUpper()</a>
							</div>
						</div>
					}
				}
				else if (Model.HomeCategories.Any())
				{
					var groupFallbackImages = new[] { "/images/category/category1.jpg", "/images/category/category2.jpg", "/images/category/category3.jpg", "/images/category/category4.jpg", "/images/category/category5.jpg" };
					for (var i = 0; i < Model.HomeCategories.Count; i++)
					{
						var category = Model.HomeCategories[i];
						<div class="swiper-slide">
							<div class="card-catogary">
								<img class="media" src="@(category.IconUrl ?? groupFallbackImages[i % groupFallbackImages.Length])" alt="@category.Name">
								<a asp-controller="Post" asp-action="Category" asp-route-id="@(category.Slug ?? category.Id.ToString())"
									class="btn btn-light btn-tag">@category.Name.ToUpper()</a>
