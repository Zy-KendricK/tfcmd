									<a asp-controller="Post" asp-action="Details" asp-route-id="@Model.EventsFeatured.Id"><img
											src="@(Model.EventsFeatured.FeaturedImageUrl ?? "/images/posts/large-post/large-post2.jpg")" alt="@Model.EventsFeatured.Title"></a>
