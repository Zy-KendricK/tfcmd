						</div>
					</div>
					<div class="swiper-slide">
						<div class="card-catogary">
							<img class="media" src="~/images/category/category2.jpg" alt="">
							<a asp-controller="Post" asp-action="Index"
								class="btn btn-light btn-tag">FITNESS</a>
						</div>
					</div>
					<div class="swiper-slide">
						<div class="card-catogary">
							<img class="media" src="~/images/category/category3.jpg" alt="">
							<a asp-controller="Post" asp-action="Index"
								class="btn btn-light btn-tag">TRAVEL</a>
						</div>
					</div>
					<div class="swiper-slide">
						<div class="card-catogary">
							<img class="media" src="~/images/category/category4.jpg" alt="">
							<a asp-controller="Post" asp-action="Index"
								class="btn btn-light btn-tag">BEAUTY</a>
