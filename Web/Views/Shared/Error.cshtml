@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="section-space3 section-error section-hidden">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-xl-6 col-md-6 text-center mb-30">
                <img src="~/images/error.png" alt="">
            </div>
            <div class="col-xl-4 col-md-6 mb-30">
                <h1><span class="text-primary">404</span> <br>NOT FOUND</h1>
                <p class="warning-text">Woops. Looks like this page doesn't exist.</p>
                <p class="back-btn-text">back to <a class="btn-link" asp-controller="Home" asp-action="Index">home</a>
                </p>
                <img class="er-arrow" src="~/images/arrow.svg" alt="">
                @if (Model?.ShowRequestId ?? false)
                {
                    <p class="mt-3"><small><strong>Request ID:</strong> <code>@Model.RequestId</code></small></p>
                }
            </div>
        </div>
    </div>
</section>

