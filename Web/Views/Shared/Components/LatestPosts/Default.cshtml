@model IList<AppCore.Entities.Post>

@foreach (var post in Model)
{
	<div class="widget-post">
		<div class="post-content">
			<h6 class="post-title"><a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id">@post.Title</a></h6>
			<span class="post-date">@((post.PublishedToWebAt ?? post.CreatedAt).ToString("MMMM dd, yyyy"))</span>
		</div>
	</div>
}
