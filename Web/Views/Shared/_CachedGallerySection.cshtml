@using Microsoft.Extensions.Caching.Memory
@inject IMemoryCache Cache
@{
    // Cache key for the gallery data
    var cacheKey = "GalleryImages";
    var cacheKeyEvents = "LatestEvents";
    var cacheKeyPosts = "LatestPosts";

    // Cache duration (e.g., 1 hour)
    var cacheOptions = new MemoryCacheEntryOptions()
        .SetSlidingExpiration(TimeSpan.FromHours(1));

    // Get or set the cached data
    var galleryImages = Cache.GetOrCreate(cacheKey, entry =>
    {
        entry.SetOptions(cacheOptions);
        // TODO: Replace with actual data fetching logic
        return Enumerable.Range(1, 8).Select(i => new { Id = i, Path = $"~/images/instagram/post{i}.jpg" }).ToList();
    });
}

<section class="instagram-wrapper">
    <h5 class="main-title">Gallery</h5>
    <div class="swiper swiper-insta">
        <div class="swiper-wrapper">
            @foreach (var image in galleryImages)
            {
                <div class="swiper-slide">
                    <div class="insta-media">
                        <img src="@image.Path" alt="Gallery Image @image.Id">
                    </div>
                </div>
            }
        </div>
        <a asp-controller="Pages" asp-action="Gallery" class="btn btn-light btn-insta">
            <i class="feather icon-image me-2"></i> Go to Gallery
        </a>
    </div>
</section>

@section Scripts {
    <script>
        // Initialize Swiper for gallery
        new Swiper('.swiper-insta', {
            slidesPerView: 2,
            spaceBetween: 10,
            breakpoints: {
                640: { slidesPerView: 3 },
                768: { slidesPerView: 4 },
                1024: { slidesPerView: 6 }
            }
        });
    </script>
}
