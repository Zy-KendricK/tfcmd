@model IEnumerable<Product>
@{
    ViewData["Title"] = "Products";
}

<div class="admin-card">
    <div class="admin-card-header d-flex justify-content-between align-items-center">
        <h4 class="admin-card-title">
            <i class="uil-shopping-trolley"></i> Manage Products
        </h4>
        <a asp-action="Create" class="btn-admin btn-admin-primary">
            <i class="uil-plus"></i> Add Product
        </a>
    </div>

    <!-- Filters -->
    <div class="mb-4">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-3">
                <input type="text" name="search" value="@ViewBag.Search" class="form-admin-control"
                    placeholder="Search products..." />
            </div>
            <div class="col-md-2">
                <select name="status" class="form-admin-control">
                    <option value="">All Status</option>
                    <option value="Draft">Draft</option>
                    <option value="Published">Published</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="type" class="form-admin-control">
                    <option value="">All Types</option>
                    <option value="Physical">Physical</option>
                    <option value="Digital">Digital</option>
                    <option value="Virtual">Virtual</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn-admin btn-admin-primary">
                    <i class="uil-filter"></i> Filter
                </button>
            </div>
        </form>
    </div>

    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th style="width: 80px;">Image</th>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th style="width: 150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>
                                @{
                                    var mainImage = product.Images?.FirstOrDefault();
                                }
                                @if (mainImage != null)
                                {
                                    <img src="@mainImage.Url" alt="@product.Name"
                                        style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px;" />
                                }
                                else
                                {
                                    <div
                                        style="width: 60px; height: 60px; background: #f0f0f0; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                        <i class="uil-image" style="font-size: 24px; color: #ccc;"></i>
                                    </div>
                                }
                            </td>
                            <td>
                                <strong>@product.Name</strong>
                                @if (product.IsFeatured)
                                {
                                    <span class="status-badge" style="background: gold; color: #333;"><i
                                            class="uil-star"></i></span>
                                }
                                @if (product.IsOnSale && product.CompareAtPrice.HasValue)
                                {
                                    <span class="status-badge status-approved">Sale</span>
                                }
                            </td>
                            <td><code>@(product.SKU ?? "N/A")</code></td>
                            <td>
                                @if (product.IsOnSale && product.CompareAtPrice.HasValue)
                                {
                                    <span
                                        style="text-decoration: line-through; color: #999;">$@product.CompareAtPrice.Value.ToString("N2")</span>
                                    <br />

                                    <strong style="color: var(--theme-color-success);">$@product.Price.ToString("N2")</strong>
                                }
                                else
                                {
                                    <strong>$@product.Price.ToString("N2")</strong>
                                }
                            </td>
                            <td>
                                @if (product.TrackInventory)
                                {
                                    var stockClass = product.StockQuantity <= 0 ? "status-rejected" :
                                    (product.StockQuantity < 10 ? "status-pending" : "status-approved");
                                    <span class="status-badge @stockClass">@product.StockQuantity</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>@product.Type</td>
                            <td>
                                @{
                                    var statusClass = product.Status == ContentStatus.Published ? "status-published" :
                                    "status-draft";
                                }
                                <span class="status-badge @statusClass">@product.Status</span>
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn-admin btn-admin-sm btn-admin-primary"
                                    title="Edit">
                                    <i class="uil-edit"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@product.Id"
                                    class="btn-admin btn-admin-sm btn-admin-success" title="View">
                                    <i class="uil-eye"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@product.Id" method="post" style="display: inline;"
                                    onsubmit="return confirm('Delete this product?');">
                                    <button type="submit" class="btn-admin btn-admin-sm btn-admin-danger" title="Delete">
                                        <i class="uil-trash-alt"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4">
                            <i class="uil-shopping-trolley" style="font-size: 48px; color: #ddd;"></i>
                            <p class="text-muted mt-2">No products found.</p>
                            <a asp-action="Create" class="btn-admin btn-admin-primary">Add product</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>