@model PostViewModel
@{
    ViewData["Title"] = Model == null || Model.Id == 0 ? "Create Post" : "Edit Post";
    var isEdit = Model?.Id > 0;
}

<div class="admin-card">
    <div class="admin-card-header">
        <h4 class="admin-card-title">
            <i class="hgi-news"></i> @ViewData["Title"]
        </h4>
    </div>

    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data">
        @if (isEdit)
        {
            <input type="hidden" asp-for="Id" />
        }

        <div class="bh-web-intent">
            <label>
                <input asp-for="IntendedForWeb" type="checkbox" />
                <span>
                    <b>Intended for the public website</b>
                    <small>Tick this if the post should go to the internet after moderator approval.
                        Unticked posts stay internal to the member portal and never enter the publish flow.</small>
                </span>
            </label>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="form-admin-group">
                    <label asp-for="Title" class="form-admin-label">Title *</label>
                    <input asp-for="Title" class="form-admin-control" placeholder="Enter post title" required />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="form-admin-group">
                    <label asp-for="Slug" class="form-admin-label">Slug</label>
                    <input asp-for="Slug" class="form-admin-control" placeholder="url-friendly-slug" />
                    <small class="text-muted">Leave empty to auto-generate from title</small>
                </div>

                <div class="form-admin-group">
                    <label asp-for="Excerpt" class="form-admin-label">Excerpt</label>
                    <textarea asp-for="Excerpt" class="form-admin-control" rows="3"
                        placeholder="Brief summary of the post..."></textarea>
                </div>

                <div class="form-admin-group">
                    <label asp-for="Content" class="form-admin-label">Content *</label>
                    <textarea asp-for="Content" id="Content" class="form-admin-control wysiwyg-editor" rows="15"
                        placeholder="Write your post content here..."></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>
            </div>

            <div class="form-aside-panels">
                <div class="admin-card" style="background: #f8f9fa;">
                    <h5 class="mb-3">Publish Settings</h5>

                    <div class="form-admin-group">
                        <label asp-for="Format" class="form-admin-label">Post Format</label>
                        <select asp-for="Format" class="form-admin-control"
                            asp-items="Html.GetEnumSelectList<PostFormat>()"></select>
                    </div>

                    <div class="form-admin-group">
                        <label class="d-flex align-items-center">
                            <input asp-for="AllowComments" type="checkbox" style="margin-right: 10px;" />
                            Allow Comments
                        </label>
                    </div>
                </div>

                <div class="admin-card mt-3" style="background: #f8f9fa;">
                    <h5 class="mb-3"><i class="hgi-home-01"></i> Home Page Placement</h5>

                    <div class="form-admin-group">
                        <label asp-for="HomeSection" class="form-admin-label">Home Section</label>
                        <select asp-for="HomeSection" class="form-admin-control"
                            asp-items="Html.GetEnumSelectList<HomeSection>()"></select>
                        <small class="text-muted">Which home page section this post belongs to</small>
                    </div>

                    <div class="form-admin-group">
                        <label class="d-flex align-items-center">
                            <input asp-for="IsFeatured" type="checkbox" style="margin-right: 10px;" />
                            Featured (large slot)
                        </label>
                        <small class="text-muted">Only one featured item per section — featuring this un-features the
                            current one</small>
                    </div>

                    <div class="form-admin-group">
                        <label class="d-flex align-items-center">
                            <input asp-for="ShowOnHomePage" type="checkbox" style="margin-right: 10px;" />
                            Show on Home Page (smaller slot)
                        </label>
                    </div>

                    @{ 
                        var heroUsage = ViewData["HeroUsage"] as (int FeaturedUsed, int SecondaryUsed, int FeaturedCap, int SecondaryCap)?;
                        var whatsNewUsage = ViewData["WhatsNewUsage"] as (int FeaturedUsed, int SecondaryUsed, int FeaturedCap, int SecondaryCap)?;
                        var eventsUsage = ViewData["EventsUsage"] as (int FeaturedUsed, int SecondaryUsed, int FeaturedCap, int SecondaryCap)?;
                    }

                    @if (heroUsage.HasValue && whatsNewUsage.HasValue && eventsUsage.HasValue)
                    {
                        <div class="mt-2" style="font-size: 12px;">
                            <div class="text-muted mb-1"><strong>Section usage (featured / home slots):</strong></div>
                            <div>Hero: @heroUsage.Value.FeaturedUsed/@heroUsage.Value.FeaturedCap featured, @heroUsage.Value.SecondaryUsed/@heroUsage.Value.SecondaryCap home</div>
                            <div>What's New: @whatsNewUsage.Value.FeaturedUsed/@whatsNewUsage.Value.FeaturedCap featured, @whatsNewUsage.Value.SecondaryUsed/@whatsNewUsage.Value.SecondaryCap home</div>
                            <div>Events: @eventsUsage.Value.FeaturedUsed/@eventsUsage.Value.FeaturedCap featured, @eventsUsage.Value.SecondaryUsed/@eventsUsage.Value.SecondaryCap home</div>
                        </div>
                    }
                </div>

                <div class="admin-card mt-3" style="background: #f8f9fa;">
                    <h5 class="mb-3">Featured Image</h5>

                    <div class="form-admin-group">
                        <label asp-for="FeaturedImageFile" class="form-admin-label">Upload header image</label>
                        <input asp-for="FeaturedImageFile" type="file" accept="image/*" class="form-admin-control" />
                        <small class="text-muted">This image shows with the title and brief on the website cards.</small>
                    </div>

                    <div class="form-admin-group">
                        <label asp-for="FeaturedImageUrl" class="form-admin-label">…or image URL</label>
                        <input asp-for="FeaturedImageUrl" class="form-admin-control"
                            placeholder="https://…" />
                    </div>

                    @if (!string.IsNullOrEmpty(Model?.FeaturedImageUrl))
                    {
                        <div class="mt-2">
                            <img src="@Model.FeaturedImageUrl" alt="Featured"
                                style="max-width: 100%; border-radius: 8px;" />
                        </div>
                    }
                </div>

                <div class="admin-card mt-3" style="background: #f8f9fa;">
                    <h5 class="mb-3"><i class="hgi-user-group"></i> Group &amp; Event</h5>

                    <div class="form-admin-group">
                        <label asp-for="SocialGroupId" class="form-admin-label">Group</label>
                        <select asp-for="SocialGroupId" class="form-admin-control"
                            asp-items="@(ViewBag.GroupOptions as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)">
                            <option value="">— None (site-wide) —</option>
                        </select>
                        <small class="text-muted">Link this post/event to a group so it shows on the group's page</small>
                    </div>

                    <div class="form-admin-group">
                        <label asp-for="EventDate" class="form-admin-label">Event date</label>
                        <input asp-for="EventDate" type="datetime-local" class="form-admin-control" />
                        <small class="text-muted">Set for events — used to split upcoming vs past events</small>
                    </div>
                </div>

                <div class="admin-card mt-3" style="background: #f8f9fa;">
                    <h5 class="mb-3">SEO Settings</h5>

                    <div class="form-admin-group">
                        <label asp-for="MetaTitle" class="form-admin-label">Meta Title</label>
                        <input asp-for="MetaTitle" class="form-admin-control" placeholder="SEO Title" />
                    </div>

                    <div class="form-admin-group">
                        <label asp-for="MetaDescription" class="form-admin-label">Meta Description</label>
                        <textarea asp-for="MetaDescription" class="form-admin-control" rows="2"
                            placeholder="SEO Description"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn-admin btn-admin-primary">
                <i class="hgi-floppy-disk"></i> @(isEdit ? "Update Post" : "Create Post")
            </button>

            @if (!isEdit)
            {
                <button type="submit" name="status" value="PendingReview" class="btn-admin btn-admin-warning">
                    <i class="hgi-file-upload"></i> Save & Submit for Review
                </button>
            }

            <a asp-action="Index" class="btn-admin" style="background: #e0e0e0;">
                <i class="hgi-arrow-left-01"></i> Cancel
            </a>
        </div>
    </form>
</div>

@await Html.PartialAsync("_WysiwygScripts")
<script>
    // Auto-generate slug from title
    (function () {
        var title = document.getElementById('Title');
        var slugField = document.getElementById('Slug');
        if (title && slugField) {
            title.addEventListener('blur', function () {
                if (!slugField.value) {
                    slugField.value = this.value
                        .toLowerCase()
                        .replace(/[^\w\s-]/g, '')
                        .replace(/\s+/g, '-')
                        .replace(/-+/g, '-')
                        .trim();
                }
            });
        }
    })();
</script>
