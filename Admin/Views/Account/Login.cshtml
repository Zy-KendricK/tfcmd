@model Admin.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_LoginLayout";
}

<h2 class="animated fadeInDown">Welcome</h2>
<p class="subtitle animated fadeInDown" style="animation-delay: 0.1s;">
    Sign in to manage the Tema Friends Club of Maryland website.
</p>

<div class="beehive-login-element beehive-element compact on-dark animated fadeInUp" style="animation-delay: 0.2s;">
    <div class="login-form-wrapper">
        <form asp-action="Login" method="post" id="element-login-form" class="beehive-login-form element-login-form"
            name="element-login">
            <div asp-validation-summary="All" class="beehive-login-result"></div>

            <div class="form-group">
                <div class="user-name">
                    <label class="screen-reader-text" for="element-username">Email/username</label>
                    <span class="icon"><i class="hgi-user"></i></span>
                    <input type="email" asp-for="Email" id="element-username" class="username-control" required
                        autocomplete="username" placeholder="Email or username">
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>
            </div>

            <div class="form-group">
                <div class="pass">
                    <label class="screen-reader-text" for="element-password">Password</label>
                    <span class="icon"><i class="hgi-lock"></i></span>
                    <input type="password" asp-for="Password" id="element-password" class="password-control" required
                        autocomplete="current-password" placeholder="Password">
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>
            </div>

            <div class="form-options">
                <div class="row">
                    <div class="col-12">
                        <div class="forgetmenot">
                            <label for="element-rememberme">
                                <input asp-for="RememberMe" id="element-rememberme" type="checkbox" /> Remember me
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="submit">
                <button type="submit" id="element_login_submit" class="wide submit-login ellipsis">Log into your
                    account</button>
            </div>

            <div class="register-link">
                <p class="color-primary">&copy; @DateTime.Now.Year Tema Friends Club of Maryland</p>
            </div>
        </form>
    </div>
</div>