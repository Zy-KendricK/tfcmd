@model ContactMessage
@{
    ViewData["Title"] = "Message Details";
}

<div class="admin-card">
    <div class="admin-card-header d-flex justify-content-between align-items-center">
        <h4 class="admin-card-title">
            <i class="hgi-mail-open"></i> @(Model.Subject ?? "(no subject)")
        </h4>
        <a asp-action="Index" class="btn-admin" style="background: #e0e0e0;">
            <i class="hgi-arrow-left-01"></i> Back
        </a>
    </div>

    <div class="row">
        <div class="col-md-8">
            <h5>Message</h5>
            <p style="white-space: pre-wrap;">@Model.Message</p>

            @if (Model.Replies != null && Model.Replies.Any())
            {
                <h5 class="mt-4">Replies (@Model.Replies.Count)</h5>
                @foreach (var reply in Model.Replies.OrderBy(r => r.CreatedAt))
                {
                    <div class="admin-card mt-2" style="background: #f8f9fa;">
                        <small class="text-muted">@reply.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                        <p class="mb-0" style="white-space: pre-wrap;">@reply.Content</p>
                    </div>
                }
            }
        </div>

        <div class="col-md-4">
            <div class="admin-card" style="background: #f8f9fa;">
                <h5 class="mb-3">Sender</h5>
                <dl class="row mb-0">
                    <dt class="col-4">Name</dt>
                    <dd class="col-8">@Model.Name</dd>
                    <dt class="col-4">Email</dt>
                    <dd class="col-8"><a href="mailto:@Model.Email">@Model.Email</a></dd>
                    <dt class="col-4">Phone</dt>
                    <dd class="col-8">@(Model.Phone ?? "—")</dd>
                    <dt class="col-4">Category</dt>
                    <dd class="col-8">@(Model.Category?.Name ?? "—")</dd>
                    <dt class="col-4">Received</dt>
                    <dd class="col-8">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</dd>
                    <dt class="col-4">Status</dt>
                    <dd class="col-8"><span class="status-badge status-pending">@Model.Status</span></dd>
                </dl>
            </div>

            <div class="admin-card mt-3" style="background: #f8f9fa;">
                <h5 class="mb-3">Update Status</h5>
                <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-admin-group">
                        <select name="status" class="form-admin-control">
                            @foreach (ContactMessageStatus status in Enum.GetValues<ContactMessageStatus>())
                            {
                                <option value="@status" selected="@(Model.Status == status)">@status</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn-admin btn-admin-primary w-100">
                        <i class="hgi-floppy-disk"></i> Update
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
