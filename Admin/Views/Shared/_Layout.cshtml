                height: 100%;
                margin: 0;
                background: transparent;
                border-top: 4px solid #1b69ab;
                border-right: 4px solid transparent;
                border-radius: 50%;
                animation: 1s preloaderSpin linear infinite;
                position: absolute;
                top: 0;
                left: 0;
