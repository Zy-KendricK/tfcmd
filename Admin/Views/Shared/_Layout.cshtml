                                <div class="col-lg-4 col-aside">
                                    <aside id="admin_sidebar" class="widget-area sidebar-widget-area sticky-sidebar">
                                        @if (IsSectionDefined("Sidebar"))
                                        {
                                            @RenderSection("Sidebar", required: false)
                                        }
                                        else
                                        {
                                            var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                                            var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
                                            var isFormScreen = currentAction.StartsWith("Create",
                                        StringComparison.OrdinalIgnoreCase) || currentAction.StartsWith("Edit",
                                        StringComparison.OrdinalIgnoreCase);
                                            if (controller == "Dashboard")
                                            {
                                                var quickLinks = new[] { ("hgi-user-group", "Manage Members", "Members", "Index"),
                                    ("hgi-notebook", "Review Activity", "Activity", "Index"), ("hgi-shopping-basket-01",
                        "Manage Shop", "Shop", "Index"), ("hgi-mail-01", "Read Messages", "Contact",
                                "Index"), ("hgi-file-security", "View Audit Logs", "Audit", "Index") };
                                                <div class="widget widget_nav_menu">
                                                    <h5 class="widget-title">Quick Actions</h5>
                                                    <ul class="menu">
                                                        @foreach (var (icon, text, ctrl, action) in quickLinks)
                                                        {
                                                            <li class="menu-item">
                                                                <a asp-controller="@ctrl" asp-action="@action"><i class="@icon"></i>
                                                                    @text</a>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                }
                                                if (!isFormScreen)
                                                {
                                                    var sidebarAdmins = UserManager.Users
                                                        .Where(u => u.IsActive && !u.IsDeleted)
                                                        .OrderByDescending(u => u.LastLoginAt ?? u.CreatedAt)
                                                        .Take(6)
                                                        .ToList();
                                                    <div class="widget buddy-bridge-dynamic-members-list buddypress">
                                                        <h5 class="widget-title">Members</h5>
                                                        <div class="item-options">
                                                            <a asp-controller="Members" asp-action="Index">Newest</a>
                                                            <span class="bp-separator" role="separator">|</span>
                                                            <a asp-controller="Members" asp-action="Index" class="selected">Active</a>
                                                        </div>
                                                        <ul class="item-list" aria-live="polite" aria-relevant="all" aria-atomic="true">
                                                            @foreach (var admin in sidebarAdmins)
                                                            {
                                                                var adminName = admin.DisplayName ?? admin.UserName;
                                                                <li class="vcard">
                                                                    <div class="item-avatar">
                                                                        <a asp-controller="Members" asp-action="Details"
                                                                           asp-route-id="@admin.Id">
                                                                            @await Html.PartialAsync("_UserAvatar", admin, new
                                                                    ViewDataDictionary(ViewData)
                                                                            { ["size"] = 50 })
                                                                        </a>
                                                                    </div>
                                                                    <div class="item">
                                                                        <div class="item-title fn">
                                                                            <a asp-controller="Members" asp-action="Details"
                                                                               asp-route-id="@admin.Id">@adminName</a>
                                                                        </div>
                                                                        <div class="item-meta">
                                                                            <span class="activity">
                                                                                @(admin.LastLoginAt.HasValue
                                                                                    ? $"Active {GetRelativeTime(admin.LastLoginAt.Value)}"
                                                                                    : "Not recently active")
                                                                            </span>
                                                                        </div>
                                                                    </div>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                }
                                            }
                                        </aside>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (SignInManager.IsSignedIn(User))
            {
                <!-- Messenger dock (Beehive buddy-chat) -->
                <div id="buddy-chat-app" class="dash" data-current-user="@user?.Id"
                     data-buddies-url="@Url.Action("Buddies", "Chat")" data-history-url="@Url.Action("History", "Chat")"
                     data-send-url="@Url.Action("Send", "Chat")" data-updates-url="@Url.Action("Updates", "Chat")"
                     data-markread-url="@Url.Action("MarkRead", "Chat")">
                    @Html.AntiForgeryToken()
                    <div id="buddy-chat-buddies" class="collapsed">
                        <div class="buddy-chat-buddies__container">
                            <div class="header-container">
                                <div class="header-title">
                                    <span class="dashicons dashicons-format-chat"></span>
                                    <div class="window-title">
                                        <h5>Messenger</h5>
                                    </div>
                                </div>
                                <div class="dropd-group dropd-dr">
                                    <a class="dropd-control mute" href="#" role="button"><span
                                        class="dashicons dashicons-admin-generic"></span></a>
                                        <div class="dropd-menu">
                                            <a class="dropd-item" id="bpc-toggle-sound" href="#">Mute</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="buddy-chat-buddies__scroll">
                                    <div class="buddy-chat-buddies__content">
                                        <ul class="buddy-chat-nav-tabs">
                                            <li class="item">
                                                <a class="item-link active" href="#">Admins</a>
                                            </li>
                                        </ul>
                                        <div class="bpc-tab-content" id="buddy-list">
                                            <div class="bpc-igroup">
                                                <div class="bpc-igroup-prepend">
                                                    <span class="bpc-igroup-text"><span
                                                        class="dashicons dashicons-search"></span></span>
                                                    </div>
                                                    <input type="text" class="bpc-form-control" id="bpc-buddy-filter"
                                                           aria-label="Find admins" placeholder="Find admins" />
                                                </div>
                                                <div class="bpc-buddy-list friends" id="bpc-buddy-items"></div>
                                                <div class="bpc-item bpc-empty" style="display:none;"><span class="bpc-notice">No other
                                                    administrators yet.</span></div>
                                                    <div class="bpc-item bpc-loading"><span class="bpc-notice">Loading...</span></div>
                                                </div>
                                            </div>
                                        </div>
                                        <div id="buddy-chat-buddies__collapser" class="buddy-chat-buddies__collapser">
                                            <div class="collapse-icon">
                                                <span class="dashicons dashicons-arrow-right-alt2"></span>
                                            </div>
                                            <div class="action-text">
                                                <h5>Collapse</h5>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div id="buddy-chat-windows">
                                    <ul class="bpc-chat-windows-list"></ul>
                                </div>
                            </div>
                        }

                        <!-- Scripts -->
                        <script src="~/lib/jquery/dist/jquery.min.js"></script>
                        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
                            <script src="~/js/admin-chat.js" asp-append-version="true"></script>
                        }

                        <script>
                                document.addEventListener('DOMContentLoaded', function () {
                                    document.querySelectorAll('i[class*="hgi-"], i[class*="uil-"]').forEach(function (icon) {
                                        if (icon.classList.contains('hgi-stroke-left')) {
                                            icon.classList.remove('hgi-stroke-left');
                                        }
                                        if (!icon.classList.contains('hgi-stroke')) {
                                            icon.classList.add('hgi-stroke');
                                        }
                                    });
                                });

                                // Move Create/Edit form settings panels into the right sidebar.
                                // The HTML5 form attribute keeps the moved inputs bound to the form on submit.
                                (function () {
                                    var panels = document.querySelector('.col-main .form-aside-panels');
                                    var aside = document.getElementById('admin_sidebar');
                                    if (!panels || !aside) return;
                                    var form = panels.closest('form');
                                    if (form) {
                                        if (!form.id) { form.id = 'admin-main-form'; }
                                        panels.querySelectorAll('input, select, textarea, button').forEach(function (el) {
                                            if (!el.hasAttribute('form')) { el.setAttribute('form', form.id); }
                                        });
                                    }
                                    aside.insertBefore(panels, aside.firstChild);
                                })();

                                var adminLoaderActiveCount = 0;

                                function showAdminLoader() {
                                    var loader = document.getElementById('admin-global-loader');
                                    if (!loader) return;
                                    adminLoaderActiveCount = Math.max(0, adminLoaderActiveCount + 1);
                                    loader.style.display = 'flex';
                                    loader.classList.add('active');
                                    loader.setAttribute('aria-hidden', 'false');
                                }

                                function hideAdminLoader() {
                                    var loader = document.getElementById('admin-global-loader');
                                    if (!loader) return;
                                    adminLoaderActiveCount = Math.max(0, adminLoaderActiveCount - 1);
                                    if (adminLoaderActiveCount > 0) return;
                                    loader.classList.remove('active');
                                    loader.style.display = 'none';
                                    loader.setAttribute('aria-hidden', 'true');
                                }

                                $(document).ready(function () {
                                    $('.beehive-preloader').fadeOut();

                                    $(document).on('submit', 'form', function (event) {
                                        var form = $(this);
                                        if (form.attr('data-no-loader') === 'true') {
                                            return true;
                                        }
                                        showAdminLoader();
                                    });

                                    $(document).on('click', 'a[href]:not([target=_blank]):not([data-no-loader=true])', function (e) {
                                        var href = $(this).attr('href');
                                        if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:')) {
                                            return;
                                        }
                                        if (href.indexOf('javascript:') === 0) {
                                            return;
                                        }
                                        if (href.indexOf('http://') === 0 || href.indexOf('https://') === 0) {
                                            var currentOrigin = window.location.origin;
                                            if (href.indexOf(currentOrigin) !== 0) {
                                                return;
