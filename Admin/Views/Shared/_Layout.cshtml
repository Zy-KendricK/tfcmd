                <div class="preloader-swapping">
                    <img src="~/logo-tfcmd.png" alt="" />
                </div>
            </div>
            <!-- Header -->
            <header id="sochead" class="site-header social-header user-nav-active">
                <nav class="navbar beehive-navbar social fixed-top">
                    <div class="container">
                        <div class="admin-header-title" style="color: #fff; font-weight: 600;">
                            <i class="hgi-layers-01" style="margin-right: 10px;"></i>
                            @ViewData["Title"]
                        </div>

                        <ul id="navbar-user" class="navbar-nav navbar-user">
                            @if (SignInManager.IsSignedIn(User))
                            {
                                <li class="nav-item dropdown">
                                    <a href="#" class="nav-link dropdown-toggle d-flex align-items-center"
                                       data-bs-toggle="dropdown" data-toggle="dropdown">
                                        @await Html.PartialAsync("_UserAvatar", user, new ViewDataDictionary(ViewData)
                                        {
                                            ["size"] = 32,
                                            ["cssClass"] = "me-2"
                                        })
                                        <span>@displayName</span>
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-right dropdown-menu-end">
                                        <div class="px-3 py-2 border-bottom">
                                            <div class="fw-semibold">@displayName</div>
                                            <div class="small text-muted">@user?.Email</div>
                                        </div>
                                        <a class="dropdown-item" asp-controller="Dashboard" asp-action="Profile">
                                            <i class="hgi-user"></i> Profile
                                        </a>
                                        <a class="dropdown-item" asp-controller="Dashboard" asp-action="Settings">
                                            <i class="hgi-dashboard-square-setting"></i> Settings
                                        </a>
                                        <div class="dropdown-divider"></div>
                                        <form asp-controller="Account" asp-action="Logout" method="post" style="margin: 0;">
                                            <button type="submit" class="dropdown-item">
                                                <i class="hgi-logout-01"></i> Sign out
                                            </button>
                                        </form>
                                    </div>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a href="~/Account/Login" class="nav-link login">Login</a>
                                </li>
                            }
                        </ul>
                    </div>
                </nav>
            </header>

            <!-- Main Content -->
            <div id="content" class="site-content">
                <div id="primary" class="content-area">
                    <div class="layout social">
                        <div class="container-fluid">
                            <div class="row">
                                <div class="col-lg-8 col-main">
                                    <main id="main" class="main-content">
                                        <div class="admin-content-wrapper">
                                            <!-- Flash Messages -->
                                            @if (TempData["Success"] != null)
                                            {
                                                <div class="alert alert-success alert-dismissible fade show" role="alert">
