                line-height: 1;
            }

            #buddy-chat-app .chat-window__input--field:empty::before {
                content: attr(data-placeholder);
                color: #9aa0ac;
                pointer-events: none;
            }

            #buddy-chat-app .bpc-send-failed span {
                color: var(--theme-color-error);
                font-style: italic;
            }

            #buddy-chat-app .window-buddy-name {
                font-weight: 600;
                margin-left: 8px;
                flex: 1 1 auto;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            /* ===== Shop grid: placeholder for products without an image ===== */
            .products .product-img .bpc-product-placeholder {
                width: 100%;
                aspect-ratio: 1 / 1;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #f0f2f5;
            }

            .products .product-img .bpc-product-placeholder i {
                font-size: 42px;
                color: #c3c9d2;
            }

            /* Admin status badge on product cards (Draft/Pending/Rejected) */
            .products .item-product .admin-status {
                position: absolute;
                top: 12px;
                right: 12px;
                z-index: 2;
            }

            .panel-block .dark {
                background-image: url(logo.png);
                background-position: top;
                background-repeat: no-repeat;
                background-size: contain;
            }
    </style>

    @RenderSection("Styles", required: false)
</head>

<body
