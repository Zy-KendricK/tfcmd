@model AppCore.Entities.AuditLog
@{
    ViewData["Title"] = "Audit Log Details";
}

<!-- Title bar (template: beehive-title-bar) -->
<div class="beehive-title-bar social">
    <div class="title-bar-wrapper">
        <div class="title-wrapper">
            <h1 class="title h3">Audit Log #@Model.Id</h1>
        </div>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card-header d-flex justify-content-between align-items-center">
        <h4 class="admin-card-title">
            <i class="hgi-file-security"></i> @Model.Action
        </h4>
        <a asp-action="Index" class="btn-admin" style="background: #e0e0e0;">
            <i class="hgi-arrow-left-01"></i> Back to Audit Logs
        </a>
    </div>

    <div class="row">
        <div class="col-md-6">
            <table class="admin-table">
                <tbody>
                    <tr>
                        <th style="width: 160px;">User</th>
                        <td>
                            @if (Model.User != null)
                            {
                                <a asp-controller="Members" asp-action="Details" asp-route-id="@Model.UserId">
                                    @(Model.User.DisplayName ?? Model.User.UserName)
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">System</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>Action</th>
                        <td><span class="status-badge status-draft">@Model.Action</span></td>
                    </tr>
                    <tr>
                        <th>Entity</th>
                        <td>
                            @(Model.EntityType ?? "—")
                            @if (Model.EntityId.HasValue)
                            {
                                <small class="text-muted">#@Model.EntityId</small>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>Timestamp</th>
                        <td>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</td>
                    </tr>
                    <tr>
                        <th>IP Address</th>
                        <td>@(Model.IpAddress ?? "—")</td>
                    </tr>
                    <tr>
                        <th>User Agent</th>
                        <td><small>@(Model.UserAgent ?? "—")</small></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.OldValues) || !string.IsNullOrEmpty(Model.NewValues))
    {
        <div class="row mt-4">
            @if (!string.IsNullOrEmpty(Model.OldValues))
            {
                <div class="col-md-6">
                    <h5>Old Values</h5>
                    <pre style="background: #f7f7f9; border: 1px solid var(--theme-color-border); border-radius: 4px; padding: 12px; max-height: 400px; overflow: auto; font-size: 12px;">@Model.OldValues</pre>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.NewValues))
            {
                <div class="col-md-6">
                    <h5>New Values</h5>
                    <pre style="background: #f7f7f9; border: 1px solid var(--theme-color-border); border-radius: 4px; padding: 12px; max-height: 400px; overflow: auto; font-size: 12px;">@Model.NewValues</pre>
                </div>
            }
        </div>
    }
</div>

@section Sidebar {
    <div class="widget widget_nav_menu">
        <h5 class="widget-title">Related</h5>
        <ul class="menu">
            <li class="menu-item">
                <a asp-action="Index"><i class="hgi-file-security"></i> All Audit Logs</a>
            </li>
            @if (Model.User != null)
            {
                <li class="menu-item">
                    <a asp-controller="Members" asp-action="Details" asp-route-id="@Model.UserId">
                        <i class="hgi-user"></i> View @(Model.User.DisplayName ?? Model.User.UserName)
                    </a>
                </li>
            }
            <li class="menu-item">
                <a asp-controller="Dashboard" asp-action="Index"><i class="hgi-home-01"></i> Dashboard</a>
            </li>
        </ul>
    </div>
}
