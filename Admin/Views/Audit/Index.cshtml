@model AuditLogListViewModel
@{
    ViewData["Title"] = "Audit Logs";
    var actions = ViewBag.Actions as IList<string> ?? new List<string>();
    var entityTypes = ViewBag.EntityTypes as IList<string> ?? new List<string>();
    int totalLogs = ViewBag.TotalLogs ?? 0;
    int todayLogs = ViewBag.TodayLogs ?? 0;
    int weekLogs = ViewBag.WeekLogs ?? 0;
    int activeUsers = ViewBag.ActiveUsers ?? 0;

    string ActionBadge(string action) => action.ToLowerInvariant() switch
    {
        var a when a.Contains("delete") => "status-rejected",
        var a when a.Contains("create") || a.Contains("add") => "status-approved",
        var a when a.Contains("update") || a.Contains("edit") => "status-pending",
        var a when a.Contains("login") || a.Contains("logout") => "status-draft",
        _ => "status-draft"
    };
}

<!-- Title bar (template: beehive-title-bar) -->
<div class="beehive-title-bar social">
    <div class="title-bar-wrapper">
        <div class="title-wrapper">
            <h1 class="title h3">Audit Logs</h1>
        </div>
    </div>
</div>

<!-- Filters (template: subnav-filters presentation) -->
<div class="admin-card" style="margin-bottom: 20px;">
    <form asp-action="Index" method="get" class="row g-3">
        <div class="col-md-3">
            <input type="text" name="search" value="@Model.Search" class="form-admin-control"
                   placeholder="Search user, action, IP..." />
        </div>
        <div class="col-md-2">
            <select name="actionType" class="form-admin-control" onchange="this.form.submit()">
                <option value="">All Actions</option>
                @foreach (var a in actions)
                {
                    <option value="@a" selected="@(Model.Action == a)">@a</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="entityType" class="form-admin-control" onchange="this.form.submit()">
                <option value="">All Entities</option>
                @foreach (var t in entityTypes)
                {
                    <option value="@t" selected="@(Model.EntityType == t)">@t</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" class="form-admin-control" />
        </div>
        <div class="col-md-2">
            <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" class="form-admin-control" />
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn-admin btn-admin-primary" style="width:100%;">
                <i class="hgi-filter"></i>
            </button>
        </div>
    </form>
</div>

<div class="admin-card">
    <div class="admin-card-header d-flex justify-content-between align-items-center">
        <h4 class="admin-card-title">
            <i class="hgi-file-security"></i> System Audit Trail
        </h4>
        <span class="text-muted">@Model.TotalCount record@(Model.TotalCount == 1 ? "" : "s")</span>
    </div>

    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>IP Address</th>
                    <th>When</th>
                    <th style="width: 90px;">Details</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Logs != null && Model.Logs.Any())
                {
                    @foreach (var log in Model.Logs)
                    {
                        <tr>
                            <td>
                                @if (log.User != null)
                                {
                                    <div class="d-flex align-items-center" style="gap: 8px;">
                                        @await Html.PartialAsync("_UserAvatar", log.User, new ViewDataDictionary(ViewData) { ["size"] = 28 })
                                        <a asp-controller="Members" asp-action="Details" asp-route-id="@log.UserId">
                                            @(log.User.DisplayName ?? log.User.UserName)
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">System</span>
                                }
                            </td>
                            <td>
                                <span class="status-badge @ActionBadge(log.Action)">@log.Action</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(log.EntityType))
                                {
                                    <text>@log.EntityType</text>
                                    @if (log.EntityId.HasValue)
                                    {
                                        <small class="text-muted"> #@log.EntityId</small>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>
                            <td><small>@(log.IpAddress ?? "—")</small></td>
                            <td>
                                <span title="@log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC">
                                    @log.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                </span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@log.Id" class="btn-admin btn-admin-sm">
                                    <i class="hgi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="text-center py-5">
                                <i class="hgi-file-security" style="font-size: 64px; color: #ddd;"></i>
                                <p class="text-muted mt-3">No audit log entries match the current filters.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @{
                    var start = Math.Max(1, Model.CurrentPage - 3);
                    var end = Math.Min(Model.TotalPages, Model.CurrentPage + 3);
                }
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)"
                           asp-route-search="@Model.Search" asp-route-actionType="@Model.Action"
                           asp-route-entityType="@Model.EntityType"
                           asp-route-from="@(Model.From?.ToString("yyyy-MM-dd"))"
                           asp-route-to="@(Model.To?.ToString("yyyy-MM-dd"))">&larr;</a>
                    </li>
                }
                @for (int i = start; i <= end; i++)
                {
                    <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i"
                           asp-route-search="@Model.Search" asp-route-actionType="@Model.Action"
                           asp-route-entityType="@Model.EntityType"
                           asp-route-from="@(Model.From?.ToString("yyyy-MM-dd"))"
                           asp-route-to="@(Model.To?.ToString("yyyy-MM-dd"))">@i</a>
                    </li>
                }
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)"
                           asp-route-search="@Model.Search" asp-route-actionType="@Model.Action"
                           asp-route-entityType="@Model.EntityType"
                           asp-route-from="@(Model.From?.ToString("yyyy-MM-dd"))"
                           asp-route-to="@(Model.To?.ToString("yyyy-MM-dd"))">&rarr;</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

@section Sidebar {
    <!-- Screen-specific sidebar: audit stats -->
    <div class="widget">
        <h5 class="widget-title">Audit Overview</h5>
        <ul class="item-list">
            <li class="vcard" style="display:flex; justify-content:space-between; padding: 8px 0;">
                <span><i class="hgi-database"></i> Total entries</span>
                <strong>@totalLogs.ToString("N0")</strong>
            </li>
            <li class="vcard" style="display:flex; justify-content:space-between; padding: 8px 0;">
                <span><i class="hgi-clock-01"></i> Today</span>
                <strong>@todayLogs.ToString("N0")</strong>
            </li>
            <li class="vcard" style="display:flex; justify-content:space-between; padding: 8px 0;">
                <span><i class="hgi-calendar-01"></i> Last 7 days</span>
                <strong>@weekLogs.ToString("N0")</strong>
            </li>
            <li class="vcard" style="display:flex; justify-content:space-between; padding: 8px 0;">
                <span><i class="hgi-user-group"></i> Active users (7d)</span>
                <strong>@activeUsers.ToString("N0")</strong>
            </li>
        </ul>
    </div>
    <div class="widget widget_nav_menu">
        <h5 class="widget-title">Related</h5>
        <ul class="menu">
            <li class="menu-item">
                <a asp-controller="Members" asp-action="Index"><i class="hgi-user-group"></i> Manage Members</a>
            </li>
            <li class="menu-item">
                <a asp-controller="Maintenance" asp-action="Index"><i class="hgi-arrow-reload-horizontal"></i> Maintenance</a>
            </li>
            <li class="menu-item">
                <a asp-controller="Dashboard" asp-action="Index"><i class="hgi-home-01"></i> Dashboard</a>
            </li>
        </ul>
    </div>
}
