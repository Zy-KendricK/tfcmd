@model PhotoViewModel
@{
    var isEdit = Model?.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Photo" : "Upload Photo";
}

<div class="admin-card">
    <div class="admin-card-header">
        <h4 class="admin-card-title">
            <i class="hgi-image-add-01"></i> @ViewData["Title"]
        </h4>
    </div>

    <form asp-action="@(isEdit ? "EditPhoto" : "UploadPhoto")" method="post" enctype="multipart/form-data">
        @if (isEdit)
        {
            <input type="hidden" asp-for="Id" />
        }

        <div class="bh-web-intent">
            <label>
                <input asp-for="IntendedForWeb" type="checkbox" />
                <span>
                    <b>Intended for the public website</b>
                    <small>Tick this if the photo should go to the internet after moderator approval.
                        Unticked photos stay internal to the member portal and never enter the publish flow.</small>
                </span>
            </label>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="form-admin-group">
                    <label asp-for="Title" class="form-admin-label">Title *</label>
                    <input asp-for="Title" class="form-admin-control" placeholder="Photo title" required />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="form-admin-group">
                    <label asp-for="Description" class="form-admin-label">Description</label>
                    <textarea asp-for="Description" class="form-admin-control" rows="4"
                        placeholder="Optional caption or description..."></textarea>
                </div>

                <div class="form-admin-group">
                    <label asp-for="ImageFile" class="form-admin-label">@(isEdit ? "Replace image" : "Image file *")</label>
                    <input asp-for="ImageFile" type="file" accept="image/*" class="form-admin-control" />
                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                </div>

                <div class="form-admin-group">
                    <label asp-for="Url" class="form-admin-label">…or image URL</label>
                    <input asp-for="Url" class="form-admin-control" placeholder="https://…" />
                </div>

                @if (isEdit && !string.IsNullOrEmpty(Model?.Url))
                {
                    <div class="form-admin-group">
                        <img src="@Model.Url" alt="Current photo" style="max-width: 320px; border-radius: 8px;" />
                    </div>
                }
            </div>

            <div class="form-aside-panels">
                <div class="admin-card" style="background: #f8f9fa;">
                    <h5 class="mb-3">Details</h5>

                    <div class="form-admin-group">
                        <label asp-for="AlbumId" class="form-admin-label">Album</label>
                        <select asp-for="AlbumId" class="form-admin-control"
                            asp-items="@(ViewBag.Albums as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)">
                            <option value="">— No album —</option>
                        </select>
                    </div>

                    <div class="form-admin-group">
                        <label asp-for="Location" class="form-admin-label">Location</label>
                        <input asp-for="Location" class="form-admin-control" placeholder="Where was it taken?" />
                    </div>

                    <div class="form-admin-group">
                        <label asp-for="TakenAt" class="form-admin-label">Taken on</label>
                        <input asp-for="TakenAt" type="datetime-local" class="form-admin-control" />
                    </div>

                    <div class="form-admin-group">
                        <label class="d-flex align-items-center">
                            <input asp-for="IsFeatured" type="checkbox" style="margin-right: 10px;" />
                            Featured photo
                        </label>
                    </div>

                    <div class="form-admin-group">
                        <label class="d-flex align-items-center">
                            <input asp-for="AllowComments" type="checkbox" style="margin-right: 10px;" />
                            Allow comments
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn-admin btn-admin-primary">
                <i class="hgi-floppy-disk"></i> @(isEdit ? "Update Photo" : "Upload Photo")
            </button>
            <a asp-action="Index" class="btn-admin" style="background: #e0e0e0;">
                <i class="hgi-arrow-left-01"></i> Cancel
            </a>
        </div>
    </form>
</div>
