@model UserGroup
@{
    ViewData["Title"] = "Group Details";
}

<div class="admin-card">
    <div class="admin-card-header d-flex justify-content-between align-items-center">
        <h4 class="admin-card-title">
            <i class="hgi-layers-01"></i> @Model.Name
            @if (Model.IsSystemGroup)
            {
                <span class="status-badge status-approved">System</span>
            }
        </h4>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-admin btn-admin-primary">
                <i class="hgi-edit-01"></i> Edit
            </a>
            <a asp-action="Permissions" asp-route-id="@Model.Id" class="btn-admin btn-admin-warning">
                <i class="hgi-shield-user"></i> Permissions
            </a>
            <a asp-action="Index" class="btn-admin" style="background: #e0e0e0;">
                <i class="hgi-arrow-left-01"></i> Back
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="admin-card" style="background: #f8f9fa;">
                <h5 class="mb-3">Overview</h5>
                <dl class="row mb-0">
                    <dt class="col-5">Description</dt>
                    <dd class="col-7">@(Model.Description ?? "—")</dd>
                    <dt class="col-5">Members</dt>
                    <dd class="col-7">@(Model.Members?.Count ?? 0)</dd>
                    <dt class="col-5">Permissions</dt>
                    <dd class="col-7">@(Model.Permissions?.Count ?? 0)</dd>
                    <dt class="col-5">Created</dt>
                    <dd class="col-7">@Model.CreatedAt.ToString("MMM dd, yyyy")</dd>
                </dl>
            </div>
        </div>

        <div class="col-md-8">
            <h5 class="mb-3">Members</h5>
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Joined</th>
                            <th>Active</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Members != null && Model.Members.Any())
                        {
                            @foreach (var membership in Model.Members)
                            {
                                <tr>
                                    <td>@(membership.User?.DisplayName ?? membership.User?.Email ?? membership.UserId)</td>
                                    <td><small>@membership.JoinedAt.ToString("MMM dd, yyyy")</small></td>
                                    <td>
                                        @if (membership.IsActive)
                                        {
                                            <span class="text-success"><i class="hgi-checkmark-circle-01"></i></span>
                                        }
                                        else
                                        {
                                            <span class="text-muted"><i class="hgi-minus-sign-circle"></i></span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">No members in this group.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
