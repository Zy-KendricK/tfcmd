@model IEnumerable<ApplicationUser>
@{
    ViewData["Title"] = "Members";
}

<div class="admin-card">
    <div class="admin-card-header d-flex justify-content-between align-items-center">
        <h4 class="admin-card-title">
            <i class="uil-users-alt"></i> Manage Members
        </h4>
        <a asp-action="Create" class="btn-admin btn-admin-primary">
            <i class="uil-plus"></i> Add Member
        </a>
    </div>

    <!-- Filters -->
    <div class="mb-4">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-4">
                <input type="text" name="search" value="@ViewBag.Search" class="form-admin-control"
                    placeholder="Search members..." />
            </div>
            <div class="col-md-3">
                <select name="group" class="form-admin-control">
                    <option value="">All Groups</option>
                    @if (ViewBag.Groups != null)
                    {
                        @foreach (var group in ViewBag.Groups)
                        {
                            <option value="@group.Id" selected="@(ViewBag.GroupId == group.Id)">@group.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn-admin btn-admin-primary">
                    <i class="uil-filter"></i> Filter
                </button>
            </div>
        </form>
    </div>

    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th style="width: 60px;"></th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Groups</th>
                    <th>Status</th>
                    <th>Joined</th>
                    <th style="width: 150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var member in Model)
                    {
                        <tr>
                            <td>
                                <img src="@(member.AvatarUrl ?? "/wp-content/uploads/2020/07/logo-icon.svg")"
                                    alt="@member.DisplayName"
                                    style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;" />
                            </td>
                            <td>
                                <strong>@(member.DisplayName ?? member.UserName)</strong>
                                @if (member.IsSuperAdmin)
                                {
                                    <span class="status-badge"
                                        style="background: var(--theme-color-primary); color: #fff; margin-left: 5px;">Super
                                        Admin</span>
                                }
                            </td>
                            <td>@member.Email</td>
                            <td>
                                @if (member.GroupMemberships?.Any() == true)
                                {
                                    @foreach (var membership in member.GroupMemberships.Take(2))
                                    {
                                        <span class="status-badge status-approved">@membership.UserGroup?.Name</span>
                                    }
                                    @if (member.GroupMemberships.Count > 2)
                                    {
                                        <span class="text-muted">+@(member.GroupMemberships.Count - 2) more</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">No groups</span>
                                }
                            </td>
                            <td>
                                @if (member.EmailConfirmed)
                                {
                                    <span class="status-badge status-published">Active</span>
                                }
                                else
                                {
                                    <span class="status-badge status-pending">Pending</span>
                                }
                            </td>
                            <td>@member.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@member.Id" class="btn-admin btn-admin-sm btn-admin-primary"
                                    title="Edit">
                                    <i class="uil-edit"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@member.Id"
                                    class="btn-admin btn-admin-sm btn-admin-success" title="View">
                                    <i class="uil-eye"></i>
                                </a>
                                @if (!member.IsSuperAdmin)
                                {
                                    <form asp-action="Delete" asp-route-id="@member.Id" method="post" style="display: inline;"
                                        onsubmit="return confirm('Are you sure you want to delete this member?');">
                                        <button type="submit" class="btn-admin btn-admin-sm btn-admin-danger" title="Delete">
                                            <i class="uil-trash-alt"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4">
                            <i class="uil-users-alt" style="font-size: 48px; color: #ddd;"></i>
                            <p class="text-muted mt-2">No members found.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>