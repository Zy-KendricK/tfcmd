@model Post
@using AppCore.Entities
@{
    ViewData["Title"] = "News Details";
    var permissions = ViewBag.UserPermissions as IList<string> ?? new List<string>();
    var isSuperAdmin = ViewBag.IsSuperAdmin as bool? ?? false;
    bool HasPermission(string code) => isSuperAdmin || permissions.Contains(code);
}

<div class="admin-card">
    <div class="admin-card-header d-flex justify-content-between align-items-center">
        <h4 class="admin-card-title">
            <i class="hgi-stroke hgi-news"></i> @Model.Title
        </h4>
        <div>
            @if (HasPermission("posts.edit"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-admin btn-admin-primary">
                    <i class="hgi-edit-01"></i> Edit
                </a>
            }
            <a asp-action="Index" class="btn-admin" style="background: #e0e0e0;">
                <i class="hgi-arrow-left-01"></i> Back
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="mb-3">
                <span class="status-badge status-@Model.Status.ToString().ToLower()">@Model.Status</span>
                @if (Model.IsFeatured)
                {
                    <span class="status-badge" style="background: gold; color: #333;">Featured</span>
                }
                @if (Model.ShowOnHomePage)
                {
                    <span class="status-badge status-published">Home Page</span>
                }
                @if (Model.IsPublishedToWeb)
                {
                    <span class="status-badge status-published">Live on Website</span>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.FeaturedImageUrl))
            {
                <div class="mb-3">
                    <img src="@Model.FeaturedImageUrl" alt="@Model.Title" style="max-width: 100%; border-radius: 8px;" />
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Excerpt))
            {
                <h5>Excerpt</h5>
                <p>@Model.Excerpt</p>
            }

            <h5>Content</h5>
            <div style="white-space: pre-wrap;">@Html.Raw(Model.Content)</div>
        </div>
    </div>
</div>

@section Sidebar {
    <div class="widget">
        <h5 class="widget-title">Details</h5>
        <ul class="item-list">
            <li class="vcard" style="display:flex; justify-content:space-between; gap: 12px; padding: 8px 0;">
                <span><i class="hgi-user"></i> Author</span>
                <strong>@(Model.Author?.DisplayName ?? Model.Author?.Email ?? "—")</strong>
            </li>
            <li class="vcard" style="display:flex; justify-content:space-between; gap: 12px; padding: 8px 0;">
                <span><i class="hgi-copy-link"></i> Slug</span>
                <strong>@(Model.Slug ?? "—")</strong>
            </li>
            <li class="vcard" style="display:flex; justify-content:space-between; gap: 12px; padding: 8px 0;">
                <span><i class="hgi-eye"></i> Views</span>
                <strong>@Model.ViewCount</strong>
            </li>
            <li class="vcard" style="display:flex; justify-content:space-between; gap: 12px; padding: 8px 0;">
                <span><i class="hgi-calendar-01"></i> Created</span>
                <strong>@Model.CreatedAt.ToString("MMM dd, yyyy")</strong>
            </li>
            <li class="vcard" style="display:flex; justify-content:space-between; gap: 12px; padding: 8px 0;">
                <span><i class="hgi-edit-01"></i> Updated</span>
                <strong>@(Model.UpdatedAt?.ToString("MMM dd, yyyy") ?? "—")</strong>
            </li>
        </ul>
    </div>

    @if (Model.Tags != null && Model.Tags.Any())
    {
        <div class="widget">
            <h5 class="widget-title">Tags</h5>
            <div class="bh-actions" style="display:flex; flex-wrap:wrap; gap:6px;">
                @foreach (var postTag in Model.Tags)
                {
                    <span class="status-badge status-pending">@postTag.Tag?.Name</span>
                }
            </div>
        </div>
    }

    @if (HasPermission("posts.publish"))
    {
        <div class="widget">
            <h5 class="widget-title">Website Review</h5>
            @if (Model.Status == ContentStatus.PendingReview)
            {
                <div class="d-grid gap-2">
                    <form asp-action="Approve" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-admin btn-admin-success w-100">
                            <i class="hgi-checkmark-circle-01"></i> Approve
                        </button>
                    </form>
                    <form asp-action="Reject" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-admin btn-admin-danger w-100">
                            <i class="hgi-cancel-circle"></i> Reject
                        </button>
                    </form>
                </div>
            }

            @if (!Model.IsPublishedToWeb && Model.Status == ContentStatus.Approved && Model.IntendedForWeb)
            {
                <form asp-action="Publish" asp-route-id="@Model.Id" method="post" class="mt-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-admin btn-admin-success w-100">
                        <i class="hgi-cloud-upload"></i> Publish to Website
                    </button>
                </form>
            }

            @if (Model.IsPublishedToWeb)
            {
                <form asp-action="Unpublish" asp-route-id="@Model.Id" method="post" class="mt-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-admin btn-admin-warning w-100">
                        <i class="hgi-cloud"></i> Remove from Website
                    </button>
                </form>
            }
        </div>
    }
}
