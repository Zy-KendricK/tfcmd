@model Advert
@{
    ViewData["Title"] = "Advert Details";
}

<div class="admin-card">
    <div class="admin-card-header d-flex justify-content-between align-items-center">
        <h4 class="admin-card-title">
            <i class="hgi-tv-01"></i> @Model.Title
        </h4>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-admin btn-admin-primary">
                <i class="hgi-edit-01"></i> Edit
            </a>
            <a asp-action="Index" class="btn-admin" style="background: #e0e0e0;">
                <i class="hgi-arrow-left-01"></i> Back
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="mb-3">
                <span class="status-badge status-@Model.Status.ToString().ToLower()">@Model.Status</span>
                @if (Model.IsFeatured)
                {
                    <span class="status-badge" style="background: gold; color: #333;">Featured</span>
                }
                @if (Model.IsUrgent)
                {
                    <span class="status-badge" style="background: #dc3545; color: #fff;">Urgent</span>
                }
                @if (Model.IsPublishedToWeb)
                {
                    <span class="status-badge status-published">Live on Website</span>
                }
            </div>

            <h5>Description</h5>
            <p style="white-space: pre-wrap;">@Model.Description</p>

            @if (Model.Inquiries != null && Model.Inquiries.Any())
            {
                <h5 class="mt-4">Inquiries (@Model.Inquiries.Count)</h5>
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>From</th>
                                <th>Message</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inquiry in Model.Inquiries)
                            {
                                <tr>
                                    <td>@(inquiry.Inquirer?.DisplayName ?? inquiry.GuestName ?? "Anonymous")</td>
                                    <td><small>@inquiry.Message</small></td>
                                    <td><small>@inquiry.CreatedAt.ToString("MMM dd, yyyy")</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Sidebar {
    <div class="widget">
        <h5 class="widget-title">Details</h5>
        <ul class="item-list">
            <li class="vcard" style="display:flex; justify-content:space-between; gap: 12px; padding: 8px 0;">
                <span><i class="hgi-folder-01"></i> Category</span>
                <strong>@(Model.Category?.Name ?? "—")</strong>
            </li>
            <li class="vcard" style="display:flex; justify-content:space-between; gap: 12px; padding: 8px 0;">
                <span><i class="hgi-dollar-circle"></i> Price</span>
                <strong>@(Model.Price.HasValue ? $"{Model.Currency} {Model.Price:N2}" : "—")</strong>
            </li>
            <li class="vcard" style="display:flex; justify-content:space-between; gap: 12px; padding: 8px 0;">
                <span><i class="hgi-check-list"></i> Condition</span>
                <strong>@Model.Condition</strong>
            </li>
            <li class="vcard" style="display:flex; justify-content:space-between; gap: 12px; padding: 8px 0;">
                <span><i class="hgi-location-01"></i> Location</span>
                <strong>@(Model.Location ?? "—")</strong>
            </li>
            <li class="vcard" style="display:flex; justify-content:space-between; gap: 12px; padding: 8px 0;">
                <span><i class="hgi-user"></i> Posted By</span>
                <strong>@(Model.PostedBy?.DisplayName ?? Model.PostedBy?.Email ?? "—")</strong>
            </li>
            <li class="vcard" style="display:flex; justify-content:space-between; gap: 12px; padding: 8px 0;">
                <span><i class="hgi-eye"></i> Views</span>
                <strong>@Model.ViewCount</strong>
            </li>
            <li class="vcard" style="display:flex; justify-content:space-between; gap: 12px; padding: 8px 0;">
                <span><i class="hgi-calendar-01"></i> Created</span>
                <strong>@Model.CreatedAt.ToString("MMM dd, yyyy")</strong>
            </li>
            <li class="vcard" style="display:flex; justify-content:space-between; gap: 12px; padding: 8px 0;">
                <span><i class="hgi-clock-01"></i> Expires</span>
                <strong>@(Model.ExpiresAt?.ToString("MMM dd, yyyy") ?? "—")</strong>
            </li>
        </ul>
    </div>

    @if (Model.ShowContactInfo)
    {
        <div class="widget">
            <h5 class="widget-title">Contact</h5>
            <ul class="item-list">
                <li class="vcard" style="display:flex; justify-content:space-between; gap: 12px; padding: 8px 0;">
                    <span><i class="hgi-mail-01"></i> Email</span>
                    <strong>@(Model.ContactEmail ?? "—")</strong>
                </li>
                <li class="vcard" style="display:flex; justify-content:space-between; gap: 12px; padding: 8px 0;">
                    <span><i class="hgi-call-locked"></i> Phone</span>
                    <strong>@(Model.ContactPhone ?? "—")</strong>
                </li>
            </ul>
        </div>
    }

    @if (!Model.IsPublishedToWeb && Model.Status == ContentStatus.Approved)
    {
        <div class="widget">
            <h5 class="widget-title">Website Review</h5>
            <form asp-action="PublishToWeb" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-admin btn-admin-success w-100">
                    <i class="hgi-cloud-upload"></i> Publish to Website
                </button>
            </form>
        </div>
    }
}
