@model Activity
@{
    ViewData["Title"] = "Activity Details";
}

<div class="admin-card">
    <div class="admin-card-header d-flex justify-content-between align-items-center">
        <h4 class="admin-card-title">
            <i class="hgi-flash"></i> Activity Details
        </h4>
        <div>
            <a asp-action="Index" class="btn-admin" style="background: #e0e0e0;">
                <i class="hgi-arrow-left-01"></i> Back
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="admin-card" style="background: #f8f9fa;">
                <h5 class="mb-3">Overview</h5>
                <dl class="row mb-0">
                    <dt class="col-5">User</dt>
                    <dd class="col-7">@(Model.User?.DisplayName ?? Model.User?.Email ?? "—")</dd>
                    <dt class="col-5">Type</dt>
                    <dd class="col-7"><span class="status-badge status-pending">@Model.ActivityType</span></dd>
                    <dt class="col-5">Privacy</dt>
                    <dd class="col-7">@Model.Privacy</dd>
                    <dt class="col-5">Likes</dt>
                    <dd class="col-7">@(Model.Likes?.Count ?? 0)</dd>
                    <dt class="col-5">Comments</dt>
                    <dd class="col-7">@(Model.Comments?.Count ?? 0)</dd>
                    <dt class="col-5">Date</dt>
                    <dd class="col-7">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</dd>
                </dl>
            </div>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3"
                onsubmit="return confirm('Delete this activity?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-admin btn-admin-danger w-100">
                    <i class="hgi-delete-01"></i> Delete Activity
                </button>
            </form>
        </div>

        <div class="col-md-8">
            @if (!string.IsNullOrEmpty(Model.Content))
            {
                <h5>Content</h5>
                <p style="white-space: pre-wrap;">@Model.Content</p>
            }

            <h5 class="mt-4">Comments</h5>
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Comment</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Comments != null && Model.Comments.Any())
                        {
                            @foreach (var comment in Model.Comments.OrderByDescending(c => c.CreatedAt))
                            {
                                <tr>
                                    <td>@(comment.User?.DisplayName ?? comment.User?.Email ?? "—")</td>
                                    <td><small>@comment.Content</small></td>
                                    <td><small>@comment.CreatedAt.ToString("MMM dd, yyyy")</small></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">No comments.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
