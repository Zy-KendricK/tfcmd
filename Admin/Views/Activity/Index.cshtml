@using System.Security.Claims
@inject UserManager<ApplicationUser> UserManager
@model ActivityListViewModel
@{
    ViewData["Title"] = "Activity";
    ViewData["BodyClass"] = "activity-directory directory buddypress bp-nouveau";
    var activityTypes = ViewBag.ActivityTypes as IList<string> ?? new List<string>();
    int allCount = ViewBag.AllCount ?? 0;
    int mineCount = ViewBag.MineCount ?? 0;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var currentUser = await UserManager.GetUserAsync(User);

    string TypeLabel(string t) => t switch
    {
        "StatusUpdate" => "Updates",
        "PhotoUpload" => "Photo Uploads",
        "VideoUpload" => "Video Uploads",
        "NewPost" => "New Posts",
        "Comment" => "Comments",
        "Like" => "Likes",
        "Share" => "Shares",
        _ => t
    };

    string RelativeTime(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalMinutes < 2) return "a moment ago";
        if (span.TotalHours < 1) return $"{(int)span.TotalMinutes} minutes ago";
        if (span.TotalDays < 1) return $"{(int)span.TotalHours} hour{((int)span.TotalHours == 1 ? "" : "s")} ago";
        if (span.TotalDays < 30) return $"{(int)span.TotalDays} day{((int)span.TotalDays == 1 ? "" : "s")} ago";
        if (span.TotalDays < 365) return $"{(int)(span.TotalDays / 30)} month{((int)(span.TotalDays / 30) == 1 ? "" : "s")} ago";
        return $"{(int)(span.TotalDays / 365)} year{((int)(span.TotalDays / 365) == 1 ? "" : "s")} ago";
    }
}

<!-- Title bar (template: beehive-title-bar, screen-reader-only on activity) -->
<div class="beehive-title-bar social">
    <div class="title-bar-wrapper">
        <div class="title-wrapper screen-reader-text">
            <h1 class="title h3">Activity</h1>
        </div>
    </div>
</div>

<article id="post-0" class="bp_activity type-bp_activity post-0 page type-page status-publish hentry beehive-post">
    <div class="entry-content clearfix">
        <div id="buddypress" class="buddypress-wrap beehive bp-dir-hori-nav alignwide">

            <h2 class="bp-screen-reader-text">Post Update</h2>

            <!-- Post update form (template: bp-nouveau activity-update-form) -->
            <div id="bp-nouveau-activity-form" class="activity-update-form">
                <form asp-action="PostUpdate" method="post" id="whats-new-form" name="whats-new-form">
                    @Html.AntiForgeryToken()
                    <div id="whats-new-avatar">
                        @await Html.PartialAsync("_UserAvatar", currentUser, new ViewDataDictionary(ViewData) { ["size"] = 60 })
                    </div>
                    <div id="whats-new-content" class="jq-dd">
                        <div id="whats-new-textarea">
                            <label for="whats-new" class="bp-screen-reader-text">Post what's new</label>
                            <textarea name="content" id="whats-new" class="bp-suggestions" rows="2"
                                      placeholder="What's new, @(User.Identity?.Name)?"></textarea>
                        </div>
                        <div id="whats-new-options">
                            <div id="whats-new-submit">
                                <button type="submit" name="aw-whats-new-submit" id="aw-whats-new-submit" class="button">
                                    Post Update
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Directory nav tabs (template: activity-type-navs) -->
            <nav class="activity-type-navs main-navs bp-navs dir-navs" role="navigation" aria-label="Directory menu">
                <ul class="component-navigation activity-nav">
                    <li id="activity-all" class="dynamic @(string.IsNullOrEmpty(Model.Scope) ? "selected" : "")" data-bp-scope="all" data-bp-object="activity">
                        <a asp-action="Index">
                            All Members
                            <span class="count">@allCount</span>
                        </a>
                    </li>
                    <li id="activity-mine" class="dynamic @(Model.Scope == "mine" ? "selected" : "")" data-bp-scope="mine" data-bp-object="activity">
                        <a asp-action="Index" asp-route-scope="mine">
                            My Activity
                            <span class="count">@mineCount</span>
                        </a>
                    </li>
                    <li id="activity-mentions" class="dynamic @(Model.Scope == "mentions" ? "selected" : "")" data-bp-scope="mentions" data-bp-object="activity">
                        <a asp-action="Index" asp-route-scope="mentions">
                            Mentions
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="screen-content">

                <!-- Search + filters (template: subnav-filters) -->
                <div class="subnav-filters filters no-ajax" id="subnav-filters">
                    <div class="subnav-search clearfix">
                        <div class="dir-search activity-search bp-search" data-bp-search="activity">
                            <form asp-action="Index" method="get" class="bp-dir-search-form" id="dir-activity-search-form" role="search">
                                @if (!string.IsNullOrEmpty(Model.Scope))
                                {
                                    <input type="hidden" name="scope" value="@Model.Scope" />
                                }
                                @if (!string.IsNullOrEmpty(Model.Type))
                                {
                                    <input type="hidden" name="type" value="@Model.Type" />
                                }
                                <label for="dir-activity-search" class="bp-screen-reader-text">Search Activity...</label>
                                <input id="dir-activity-search" name="search" type="search" value="@Model.Search" placeholder="Search Activity..." />
                                <button type="submit" id="dir-activity-search-submit" class="nouveau-search-submit" name="dir_activity_search_submit">
                                    <span class="dashicons dashicons-search" aria-hidden="true"></span>
                                    <span id="button-text" class="bp-screen-reader-text">Search</span>
                                </button>
                            </form>
                        </div>
                    </div>

                    <div id="dir-filters" class="component-filters clearfix">
                        <div id="activity-filter-select" class="last filter">
                            <label class="bp-screen-reader-text" for="activity-filter-by">
                                <span>Show:</span>
                            </label>
                            <div class="select-wrap">
                                <form asp-action="Index" method="get" id="activity-filter-form">
                                    @if (!string.IsNullOrEmpty(Model.Scope))
                                    {
                                        <input type="hidden" name="scope" value="@Model.Scope" />
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Search))
                                    {
                                        <input type="hidden" name="search" value="@Model.Search" />
                                    }
                                    <select id="activity-filter-by" name="type" data-bp-filter="activity" onchange="this.form.submit()">
                                        <option value="" selected="@(string.IsNullOrEmpty(Model.Type))">&mdash; Everything &mdash;</option>
                                        @foreach (var t in activityTypes)
                                        {
                                            <option value="@t" selected="@(Model.Type == t)">@TypeLabel(t)</option>
                                        }
                                    </select>
                                </form>
                                <span class="select-arrow" aria-hidden="true"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Activity stream (template: activity-stream / activity-list) -->
                <div id="activity-stream" class="activity" data-bp-list="activity">
                    @if (Model.Activities != null && Model.Activities.Any())
                    {
                        <ul class="activity-list item-list bp-list">
                            @foreach (var activity in Model.Activities)
                            {
                                var actorName = activity.User?.DisplayName ?? activity.User?.UserName ?? "Unknown User";
                                <li class="activity activity_update activity-item" id="activity-@activity.Id" data-bp-activity-id="@activity.Id">
                                    <div class="activity-avatar item-avatar">
                                        <a asp-controller="Members" asp-action="Details" asp-route-id="@activity.UserId">
                                            @await Html.PartialAsync("_UserAvatar", activity.User, new ViewDataDictionary(ViewData) { ["size"] = 100 })
                                        </a>
                                    </div>
                                    <div class="activity-content">
                                        <div class="activity-header">
                                            <p>
                                                <a asp-controller="Members" asp-action="Details" asp-route-id="@activity.UserId">@actorName</a>
                                                @(activity.ActivityType == "StatusUpdate" ? "posted an update" : TypeLabel(activity.ActivityType).ToLowerInvariant())
                                                <a asp-action="Details" asp-route-id="@activity.Id" class="view activity-time-since bp-tooltip" data-bp-tooltip="@activity.CreatedAt.ToString("MMM dd, yyyy HH:mm")">
                                                    <span class="time-since">@RelativeTime(activity.CreatedAt)</span>
                                                </a>
                                            </p>
                                            <div class="activity-options dropleft">
                                                <a href="#" class="dropdown-toggle" data-bs-toggle="dropdown" data-toggle="dropdown" aria-expanded="false" role="button">
                                                    <i class="hgi-list-view"></i>
                                                </a>
                                                <div class="dropdown-menu">
                                                    <a class="dropdown-item" asp-action="Details" asp-route-id="@activity.Id">View Details</a>
                                                    <form asp-action="Delete" asp-route-id="@activity.Id" method="post" style="margin:0;"
                                                          onsubmit="return confirm('Delete this activity?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="dropdown-item">Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(activity.Content))
                                        {
                                            <div class="activity-inner">
                                                <p>@activity.Content</p>
                                            </div>
                                        }
                                        <div class="activity-meta action">
                                            <div class="generic-button">
                                                <a asp-action="Details" asp-route-id="@activity.Id" class="button bp-secondary-action">
                                                    <span class="bp-screen-reader-text">Comments for activity @activity.Id</span>
                                                    <span class="comment-count">@((activity.Comments?.Count ?? 0)) Comment@((activity.Comments?.Count ?? 0) == 1 ? "" : "s")</span>
                                                </a>
                                            </div>
                                            <div class="generic-button">
                                                <a asp-action="Details" asp-route-id="@activity.Id" class="button bp-like-button bp-secondary-action">
                                                    <span class="like-count">@((activity.Likes?.Count ?? 0)) Like@((activity.Likes?.Count ?? 0) == 1 ? "" : "s")</span>
                                                </a>
                                            </div>
                                            @if (activity.Privacy != ActivityPrivacy.Public)
                                            {
                                                <div class="generic-button">
                                                    <span class="button" style="pointer-events:none;"><i class="hgi-lock"></i> @activity.Privacy</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>

                        @if (Model.TotalPages > 1 && Model.CurrentPage < Model.TotalPages)
                        {
                            <ul class="activity-list item-list bp-list">
                                <li class="load-more">
                                    <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)"
                                       asp-route-scope="@Model.Scope" asp-route-type="@Model.Type" asp-route-search="@Model.Search">Load More</a>
                                </li>
                            </ul>
                        }
                    }
                    else
                    {
                        <aside class="bp-feedback bp-messages info">
                            <span class="bp-icon" aria-hidden="true"></span>
                            <p>Sorry, there was no activity found. Please try a different filter.</p>
                        </aside>
                    }
                </div>
            </div>
        </div>
    </div>
</article>

@section Sidebar {
    <!-- Screen-specific sidebar: activity overview + members (template: buddypress_sidebar) -->
    <div class="widget widget_nav_menu">
        <h5 class="widget-title">Activity Overview</h5>
        <ul class="menu">
            <li class="menu-item">
                <a asp-action="Index"><i class="hgi-notebook"></i> All Activity <span class="count" style="float:right;">@allCount</span></a>
            </li>
            <li class="menu-item">
                <a asp-action="Index" asp-route-scope="mine"><i class="hgi-user"></i> My Activity <span class="count" style="float:right;">@mineCount</span></a>
            </li>
            <li class="menu-item">
                <a asp-controller="Members" asp-action="Index"><i class="hgi-user-group"></i> Manage Members</a>
            </li>
            <li class="menu-item">
                <a asp-controller="SocialGroups" asp-action="Index"><i class="hgi-user-add-01"></i> Social Groups</a>
            </li>
        </ul>
    </div>
    @await Html.PartialAsync("_MembersWidget")
}
